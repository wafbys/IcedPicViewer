<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>IcedPicViewer.Core.Tests</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\IcedPicViewer.Core\IcedPicViewer.Core.csproj" />
  </ItemGroup>

  <!--
    FFmpeg natives for VideoFrameExtractorTests. They are not in git (see
    tools/Fetch-FFmpegNatives.ps1), so this group is simply inactive on a clean
    checkout and the affected tests return early. FFmpegBootstrap probes
    AppContext.BaseDirectory, so flattening them into the output root is enough.
    ffmpeg.exe is needed too: the tests synthesise their own H.264 clip with it.
  -->
  <ItemGroup Condition="Exists('..\..\src\native\ffmpeg\win-x64\avutil-60.dll')">
    <None Include="..\..\src\native\ffmpeg\win-x64\*.dll"
          Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
    <None Include="..\..\src\native\ffmpeg\win-x64\ffmpeg.exe"
          Link="ffmpeg.exe"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

</Project>

# FFmpeg / native video libs — never commit (GitHub 50MB+ warn; avcodec ~67MB)
# Fetch: tools/Fetch-FFmpegNatives.ps1 | .sh  →  src/native/ffmpeg/{rid}/
src/native/ffmpeg/**

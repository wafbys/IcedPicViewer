<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  IgnorableNamespaces="uap rescap desktop6">

  <Identity
    Name="BE1B75C2-BBA1-4C9E-9746-EA268E694F3D"
    Publisher="CN=AppPublisher"
    Version="0.22.0.0" />

  <mp:PhoneIdentity PhoneProductId="BE1B75C2-BBA1-4C9E-9746-EA268E694F3D" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>IcedPicViewer</DisplayName>
    <PublisherDisplayName>AppPublisher</PublisherDisplayName>
    <Logo>Assets\StoreLogo.scale-200.png</Logo>
    <!--
      MSIX 默认把打包应用对 %LOCALAPPDATA% 的写入重定向进包容器
      （...\Packages\<PFN>\LocalCache\Local\...）。本应用的全部可变状态
      按设计就应落在真实的 %LOCALAPPDATA%\IcedPicViewer（见 Core
      AppDataPaths；crash.log / settings.json 都是给用户直接查看的），
      因此关闭文件系统写虚拟化。需要上一节的 unvirtualizedResources
      受限能力（dev 场景经 dotnet run 注册不受影响；AppInstaller 分发
      会拒绝含此能力的包，本项目不分发）。
      2026-10 实测：关闭前 window_settings.txt 实际写入包容器，导致
      "状态找不到/几何陈旧"一类问题。
    -->
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
  </Properties>

  <!--
    MinVersion 与 csproj TargetPlatformMinVersion 对齐为 10.0.26100.0（Win11 24H2）。
    工程 TFM 是 net11.0-windows10.0.26100.0，低于此 OS 无法保证 WinRT 合约可用。
  -->
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.26100.0" MaxVersionTested="10.0.26226.0" />
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.26100.0" MaxVersionTested="10.0.26226.0" />
  </Dependencies>

  <Resources>
    <!-- 单语言支持：本应用未实现多语言本地化。zh-CN 作默认语言，保留 en。
         默认语言同时决定 XamlAutoFontFamily（全局字体）解析到哪支 ——
         只声明 en 时，中文字形会走泛化回退（典型症状：宋体观感）。 -->
    <Resource Language="zh-CN"/>
    <Resource Language="en"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="IcedPicViewer"
        Description="IcedPicViewer"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.scale-200.png"
        Square44x44Logo="Assets\Square44x44Logo.scale-200.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.scale-200.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.scale-200.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!--
      runFullTrust: IcedPicViewer 扫描用户任意选择的图片文件夹、读取各种格式,
      这需要传统 Win32 应用级别的文件系统访问。MSIX 沙箱默认不允许,
      必须显式声明 runFullTrust 才能跳出沙箱。
    -->
    <rescap:Capability Name="runFullTrust" />
    <!--
      unvirtualizedResources: 允许上方的 FileSystemWriteVirtualization
      声明生效（MSIX flexible virtualization）。本应用是纯查看器，
      唯一写入目标是自己的 %LOCALAPPDATA%\IcedPicViewer。
    -->
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>

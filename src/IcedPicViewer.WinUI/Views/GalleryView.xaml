<Page
    x:Class="IcedPicViewer.Views.GalleryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:IcedPicViewer"
    xmlns:controls="using:IcedPicViewer.Controls"
    xmlns:models="using:IcedPicViewer.Models"
    xmlns:vm="using:IcedPicViewer.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:DataType="vm:GalleryViewModel"
    Background="Transparent">

    <!--
        Chrome-as-overlay layout. Header (row 0) and status bar (row 2)
        have fixed Height="0" so they contribute zero vertical space to
        the grid. The ScrollViewer takes RowSpan="3" so it fills the
        whole page, and the chrome Grids also take RowSpan="3" but use
        VerticalAlignment="Top" / "Bottom" + explicit Height to float
        above the content without pushing it around. This is what makes
        hover-reveal in fullscreen feel like a floating overlay rather
        than a panel that grows and shrinks the image area.

        Mouse motion is captured on RootGrid (which spans the entire
        page) so the hit-test for the reveal zones works even when the
        pointer is over the ScrollViewer's empty area.
    -->
    <Grid x:Name="RootGrid"
          PointerMoved="RootGrid_PointerMoved"
          PointerPressed="RootGrid_PointerPressed"
          KeyDown="RootGrid_KeyDown">
        <!--
            窄窗自适应。实测（2026-10 截图）：<~1100 DIP 时右组（筛选/排序/
            搜索）被裁切压扁，600 DIP 时完全不可达。三档：
            ≥1120 全标签；840–1119 左侧按钮收成图标（ToolTip 保留）；
            <840 再收紧筛选/排序/搜索尺寸。窗口最小宽度 680 兜底
            （MainWindow 的 OverlappedPresenter.PreferredMinimumWidth）。
        -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="HeaderWidthStates">
                <VisualState x:Name="HeaderWide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1120"/>
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="HeaderCompact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="840"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="OpenFolderLabel.Visibility" Value="Collapsed"/>
                        <Setter Target="OpenFileLabel.Visibility" Value="Collapsed"/>
                        <Setter Target="CloseFolderLabel.Visibility" Value="Collapsed"/>
                        <Setter Target="RefreshLabel.Visibility" Value="Collapsed"/>
                        <Setter Target="SlideshowLabel.Visibility" Value="Collapsed"/>
                        <Setter Target="AboutLabel.Visibility" Value="Collapsed"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="HeaderNarrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="OpenFolderLabel.Visibility" Value="Collapsed"/>
                        <Setter Target="OpenFileLabel.Visibility" Value="Collapsed"/>
                        <Setter Target="CloseFolderLabel.Visibility" Value="Collapsed"/>
                        <Setter Target="RefreshLabel.Visibility" Value="Collapsed"/>
                        <Setter Target="SlideshowLabel.Visibility" Value="Collapsed"/>
                        <Setter Target="AboutLabel.Visibility" Value="Collapsed"/>
                        <Setter Target="FilterCombo.MinWidth" Value="80"/>
                        <Setter Target="SortCombo.MinWidth" Value="88"/>
                        <Setter Target="SearchBox.Width" Value="120"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="0"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="0"/>
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="MainScrollViewer"
                      Grid.Row="0" Grid.RowSpan="3"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <!-- Using the original working MasonryPanel to restore the exact waterfall visual the user requested.
                 Note: This is non-virtualizing. Virtualization work is tracked separately. -->
            <ItemsControl x:Name="MainItemsControl" ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:MasonryPanel ItemWidth="220" ItemSpacing="8"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:MediaItem">
                    <!--
                        Button (not Border) as the card root: a Button gives
                        the tile keyboard focus (Tab), Enter/Space activation,
                        a focus rectangle and a UIA Invoke pattern — all of
                        which a plain Border lacks, and without them the
                        gallery had no keyboard path at all. Click opens the
                        viewer (meaning a single mouse click now opens; a
                        double click still works because the second click
                        lands on the already-guarded OpenViewer). Visuals are
                        kept local: same card background / stroke / radius /
                        padding as before. MinWidth/MinHeight are pinned to 0
                        so the default button metrics can't force a card
                        wider than its MasonryPanel cell (cells go down to
                        110 px).
                    -->
                    <Button MinWidth="0"
                            MinHeight="0"
                            Click="ImageItem_Click"
                            RightTapped="ImageItem_RightTapped"
                            PointerEntered="Tile_PointerEntered"
                            PointerExited="Tile_PointerExited"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Margin="0"
                            Padding="4"
                            AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                            AutomationProperties.HelpText="{x:Bind DisplayLocation, Mode=OneWay}">
                        <Button.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="打开文件位置" Click="OpenFileLocation_Click"/>
                                <MenuFlyoutItem Text="删除" Click="DeleteMenuItem_Click"/>
                            </MenuFlyout>
                        </Button.ContextFlyout>
                        <Grid MinHeight="120">
                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                            <!--
                                Loading indicator shown over the empty Image
                                while the thumbnail is decoding. Without this
                                overlay the card would just be a blank
                                light-coloured rectangle (Image with null
                                source is transparent; the card's CardBackground
                                brush shows through) and the user can't tell
                                whether the gallery is stuck or still loading.
                                IsThumbnailLoading is set true in the MediaItem
                                ctor and cleared by GalleryViewModel's
                                LoadThumbnailAsync finally block.
                            -->
                            <ProgressRing IsActive="{x:Bind IsThumbnailLoading, Mode=OneWay}"
                                          Visibility="{x:Bind IsThumbnailLoadingVisibility, Mode=OneWay}"
                                          Width="32"
                                          Height="32"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            <!--
                                Play overlay shown on video cards. Bound to
                                MediaItem.IsVideoVisibility, which evaluates
                                to Visible only when Source.Kind == Video, so
                                image cards never see this element. The
                                background is intentionally a fixed
                                semi-opaque black rather than a theme brush:
                                it has to read clearly on top of any
                                thumbnail (light, dark, busy), and the few
                                theme brushes designed for "overlay on
                                arbitrary content" don't ship a high-contrast
                                solid round shape. The 40×40 size is small
                                enough to stay out of the way of the
                                thumbnail content but large enough to spot
                                at a glance while scrolling.
                            -->
                            <Border HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,8,8"
                                    Background="#CC000000"
                                    CornerRadius="20"
                                    Width="40"
                                    Height="40"
                                    Visibility="{x:Bind IsVideoVisibility, Mode=OneTime}">
                                <FontIcon Glyph="&#xE768;"
                                          FontSize="20"
                                          Foreground="White"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </Border>
                            <Border Tag="hover-overlay"
                                    Background="#33000000"
                                    CornerRadius="2"
                                    Opacity="0"
                                    IsHitTestVisible="False"/>
                            <Border Tag="hover-overlay"
                                    VerticalAlignment="Bottom"
                                    Background="#CC000000"
                                    Padding="8,6"
                                    Opacity="0"
                                    IsHitTestVisible="False">
                                <StackPanel Spacing="1">
                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                               Style="{StaticResource AppCaptionTextBlockStyle}"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind InfoLine, Mode=OneWay}"
                                               Style="{StaticResource AppCaptionTextBlockStyle}"
                                               Foreground="#E0FFFFFF"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind DisplayLocation, Mode=OneWay}"
                                               Style="{StaticResource AppCaptionTextBlockStyle}"
                                               Foreground="#B3FFFFFF"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Button>
                </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!--
            Header chrome overlay. RowSpan="3" + VerticalAlignment="Top" +
            explicit Height pins it to the top of the page regardless of
            what ScrollViewer (also RowSpan 3) does underneath. Visibility
            flips with the header auto-hide (both presenters; see
            GalleryView.xaml.cs) and on mouse-near-top.
            Background: the same in-app acrylic brush as the viewer's
            floating CommandBar, so the two toolbars read as one material
            — blur + tint keep the labels legible over the thumbnails,
            with the framework's High Contrast / transparency-off fallbacks
            handling the degraded paths.
        -->
        <Grid x:Name="HeaderChrome"
              Grid.Row="0" Grid.RowSpan="3"
              VerticalAlignment="Top"
              Height="48"
              Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
              Visibility="{x:Bind HeaderVisibility, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Command="{x:Bind ViewModel.OpenFolderCommand}"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="12,0"
                        ToolTipService.ToolTip="打开文件夹">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8DA;" FontSize="16"/>
                        <TextBlock x:Name="OpenFolderLabel" Text="打开文件夹" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="OpenFileBtn_Click"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="12,0"
                        ToolTipService.ToolTip="打开文件">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8E5;" FontSize="16"/>
                        <TextBlock x:Name="OpenFileLabel" Text="打开文件" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.CloseFolderCommand}"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="12,0"
                        ToolTipService.ToolTip="关闭目录">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8BB;" FontSize="16"/>
                        <TextBlock x:Name="CloseFolderLabel" Text="关闭目录" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.RefreshCommand}"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="12,0"
                        ToolTipService.ToolTip="刷新 (F5)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="16"/>
                        <TextBlock x:Name="RefreshLabel" Text="刷新" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <!--
                    Slideshow trigger. Click opens the viewer at the
                    last-viewed item (or the first if none yet) and
                    starts auto-advance. The actual timer / state lives
                    on the viewer's ViewerViewModel — once the viewer
                    is open, the viewer's own Slideshow button (or the
                    same gallery button, since ViewerViewModel is a
                    singleton) is what stops it. Click handler rather
                    than Command because we need to call into the
                    viewer VM, which is a sibling in the DI graph —
                    easier to do from the view than to take a circular
                    VM dep.
                -->
                <Button Click="SlideshowBtn_Click"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="12,0"
                        ToolTipService.ToolTip="幻灯片">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="16"/>
                        <TextBlock x:Name="SlideshowLabel" Text="幻灯片" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="8,0">
                <ComboBox x:Name="FilterCombo"
                          SelectedIndex="{x:Bind ViewModel.FilterIndex, Mode=TwoWay}"
                          MinWidth="92"
                          VerticalAlignment="Center"
                          ToolTipService.ToolTip="筛选：全部 / 图片 / 视频">
                    <ComboBoxItem Content="全部"/>
                    <ComboBoxItem Content="图片"/>
                    <ComboBoxItem Content="视频"/>
                </ComboBox>
                <ComboBox x:Name="SortCombo"
                          SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}"
                          MinWidth="104"
                          VerticalAlignment="Center"
                          ToolTipService.ToolTip="排序：名称 / 日期 / 大小 / 扩展名">
                    <ComboBoxItem Content="名称"/>
                    <ComboBoxItem Content="日期"/>
                    <ComboBoxItem Content="大小"/>
                    <ComboBoxItem Content="扩展名"/>
                </ComboBox>
                <ToggleButton IsChecked="{x:Bind ViewModel.SortDescending, Mode=TwoWay}"
                              Content="{x:Bind ViewModel.SortDirectionLabel, Mode=OneWay}"
                              MinWidth="60"
                              VerticalAlignment="Center"
                              ToolTipService.ToolTip="正序 / 倒序"/>
                <AutoSuggestBox x:Name="SearchBox"
                                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}"
                                PlaceholderText="查找（支持 * 和 ?）"
                                QueryIcon="Find"
                                Width="200"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="按文件名查找；支持 * 和 ? 通配符"/>
            </StackPanel>
            <Button Grid.Column="2"
                    Click="AboutButton_Click"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="12,0"
                    ToolTipService.ToolTip="关于">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE946;" FontSize="16"/>
                    <TextBlock x:Name="AboutLabel" Text="关于" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!--
            Status chrome overlay. Same pattern as header: RowSpan 3 +
            VerticalAlignment="Bottom". Background: the same acrylic brush
            as the header / viewer bars so all chrome reads as one
            material. Visibility: windowed mode shows it only as a short
            "flash" after the status text changes (delete feedback, scan
            progress — progress re-arms the flash on every update, so the
            bar stays up while something is actually running); fullscreen
            reveals it via the bottom hot-zone and hides it with the rest
            of the chrome.
        -->
        <Grid x:Name="StatusChrome"
              Grid.Row="0" Grid.RowSpan="3"
              VerticalAlignment="Bottom"
              Height="32"
              Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
              Visibility="{x:Bind StatusVisibility, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                <!-- Scan progress ring. Active while the directory scanner is
                     enumerating the filesystem (typically a few seconds for a
                     Pictures folder, tens of seconds for a whole drive). The
                     StatusText binding next to it shows the running count
                     ("Scanning... 1234 images found") updated by a throttled
                     progress sink in the VM. -->
                <ProgressRing Width="16"
                              Height="16"
                              IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsScanningVisibility, Mode=OneWay}"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0"/>

                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                           Style="{StaticResource AppCaptionTextBlockStyle}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="900"/>

                <!--
                    Background thumbnail backfill: how far the "pre-generate what
                    I haven't scrolled to yet" pass has got (GalleryViewModel.
                    StartBackfill). The bar is the at-a-glance view; StatusText
                    above carries the exact counts. Hidden whenever the pass is
                    not running.
                -->
                <ProgressBar Width="90"
                             Height="4"
                             Minimum="0"
                             Maximum="100"
                             Value="{x:Bind ViewModel.BackfillPercent, Mode=OneWay}"
                             Visibility="{x:Bind ViewModel.BackfillVisibility, Mode=OneWay}"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0"
                             ToolTipService.ToolTip="后台生成缩略图进度"/>
            </StackPanel>
        </Grid>

        <!--
            Empty state. Centered panel shown when there is nothing to
            list: no folder yet, a folder with no media, or a filter /
            search that matches nothing. The masonry is empty in all
            three cases, so a centered explanation plus the obvious next
            action beats a blank page — status text alone was easy to
            miss, and the status bar now auto-hides as well.
        -->
        <StackPanel Grid.Row="0" Grid.RowSpan="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="380"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}">
            <TextBlock Text="{x:Bind ViewModel.EmptyStateTitle, Mode=OneWay}"
                       Style="{StaticResource AppSubtitleTextBlockStyle}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
            <TextBlock Text="{x:Bind ViewModel.EmptyStateHint, Mode=OneWay}"
                       Style="{StaticResource AppBodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0">
                <Button Command="{x:Bind ViewModel.OpenFolderCommand}"
                        Content="{x:Bind ViewModel.EmptyStateOpenFolderLabel}"
                        Visibility="{x:Bind ViewModel.EmptyStateOpenFolderVisibility, Mode=OneWay}"/>
                <Button Command="{x:Bind ViewModel.ClearFiltersCommand}"
                        Content="{x:Bind ViewModel.EmptyStateClearLabel}"
                        Visibility="{x:Bind ViewModel.EmptyStateClearVisibility, Mode=OneWay}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
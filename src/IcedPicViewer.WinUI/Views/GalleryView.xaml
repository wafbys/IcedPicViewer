<Page
    x:Class="IcedPicViewer.Views.GalleryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:IcedPicViewer"
    xmlns:controls="using:IcedPicViewer.Controls"
    xmlns:models="using:IcedPicViewer.Models"
    xmlns:vm="using:IcedPicViewer.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:DataType="vm:GalleryViewModel"
    Background="Transparent">

    <!--
        Chrome-as-overlay layout. Header (row 0) and status bar (row 2)
        have fixed Height="0" so they contribute zero vertical space to
        the grid. The ScrollViewer takes RowSpan="3" so it fills the
        whole page, and the chrome Grids also take RowSpan="3" but use
        VerticalAlignment="Top" / "Bottom" + explicit Height to float
        above the content without pushing it around. This is what makes
        hover-reveal in fullscreen feel like a floating overlay rather
        than a panel that grows and shrinks the image area.

        Mouse motion is captured on RootGrid (which spans the entire
        page) so the hit-test for the reveal zones works even when the
        pointer is over the ScrollViewer's empty area.
    -->
    <Grid x:Name="RootGrid"
          PointerMoved="RootGrid_PointerMoved">
        <Grid.RowDefinitions>
            <RowDefinition Height="0"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="0"/>
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="MainScrollViewer"
                      Grid.Row="0" Grid.RowSpan="3"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <!-- Using the original working MasonryPanel to restore the exact waterfall visual the user requested.
                 Note: This is non-virtualizing. Virtualization work is tracked separately. -->
            <ItemsControl x:Name="MainItemsControl" ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:MasonryPanel ItemWidth="220" ItemSpacing="8"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:MediaItem">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Margin="0"
                            Padding="4"
                            DoubleTapped="ImageItem_DoubleTapped"
                            RightTapped="ImageItem_RightTapped"
                            PointerEntered="Tile_PointerEntered"
                            PointerExited="Tile_PointerExited"
                            AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                            AutomationProperties.HelpText="{x:Bind DisplayLocation, Mode=OneWay}">
                        <Border.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="打开文件位置" Click="OpenFileLocation_Click"/>
                                <MenuFlyoutItem Text="删除" Click="DeleteMenuItem_Click"/>
                            </MenuFlyout>
                        </Border.ContextFlyout>
                        <Grid MinHeight="120">
                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                            <!--
                                Loading indicator shown over the empty Image
                                while the thumbnail is decoding. Without this
                                overlay the card would just be a blank
                                light-coloured rectangle (Image with null
                                source is transparent; the card's CardBackground
                                brush shows through) and the user can't tell
                                whether the gallery is stuck or still loading.
                                IsThumbnailLoading is set true in the MediaItem
                                ctor and cleared by GalleryViewModel's
                                LoadThumbnailAsync finally block.
                            -->
                            <ProgressRing IsActive="{x:Bind IsThumbnailLoading, Mode=OneWay}"
                                          Visibility="{x:Bind IsThumbnailLoadingVisibility, Mode=OneWay}"
                                          Width="32"
                                          Height="32"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            <!--
                                Play overlay shown on video cards. Bound to
                                MediaItem.IsVideoVisibility, which evaluates
                                to Visible only when Source.Kind == Video, so
                                image cards never see this element. The
                                background is intentionally a fixed
                                semi-opaque black rather than a theme brush:
                                it has to read clearly on top of any
                                thumbnail (light, dark, busy), and the few
                                theme brushes designed for "overlay on
                                arbitrary content" don't ship a high-contrast
                                solid round shape. The 40×40 size is small
                                enough to stay out of the way of the
                                thumbnail content but large enough to spot
                                at a glance while scrolling.
                            -->
                            <Border HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,8,8"
                                    Background="#CC000000"
                                    CornerRadius="20"
                                    Width="40"
                                    Height="40"
                                    Visibility="{x:Bind IsVideoVisibility, Mode=OneTime}">
                                <FontIcon Glyph="&#xE768;"
                                          FontSize="20"
                                          Foreground="White"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </Border>
                            <Border Tag="hover-overlay"
                                    Background="#33000000"
                                    CornerRadius="2"
                                    Opacity="0"
                                    IsHitTestVisible="False"/>
                            <Border Tag="hover-overlay"
                                    VerticalAlignment="Bottom"
                                    Background="#CC000000"
                                    Padding="8,6"
                                    Opacity="0"
                                    IsHitTestVisible="False">
                                <StackPanel Spacing="1">
                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind InfoLine, Mode=OneWay}"
                                               Foreground="#E0FFFFFF"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind DisplayLocation, Mode=OneWay}"
                                               Foreground="#B3FFFFFF"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!--
            Header chrome overlay. RowSpan="3" + VerticalAlignment="Top" +
            explicit Height pins it to the top of the page regardless of
            what ScrollViewer (also RowSpan 3) does underneath. Visibility
            flips on fullscreen-entry and on mouse-near-top in fullscreen.
            Background is opaque (LayerFillColorDefaultBrush) so the chrome
            doesn't bleed the masonry content through it when it's shown
            on top of the cards.
        -->
        <Grid x:Name="HeaderChrome"
              Grid.Row="0" Grid.RowSpan="3"
              VerticalAlignment="Top"
              Height="48"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              Visibility="{x:Bind HeaderVisibility, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Command="{x:Bind ViewModel.OpenFolderCommand}"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="12,0"
                        ToolTipService.ToolTip="打开文件夹">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8DA;" FontSize="16"/>
                        <TextBlock Text="打开文件夹" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.RefreshCommand}"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="12,0"
                        ToolTipService.ToolTip="刷新 (F5)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="16"/>
                        <TextBlock Text="刷新" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <!--
                    Slideshow trigger. Click opens the viewer at the
                    last-viewed item (or the first if none yet) and
                    starts auto-advance. The actual timer / state lives
                    on the viewer's ViewerViewModel — once the viewer
                    is open, the viewer's own Slideshow button (or the
                    same gallery button, since ViewerViewModel is a
                    singleton) is what stops it. Click handler rather
                    than Command because we need to call into the
                    viewer VM, which is a sibling in the DI graph —
                    easier to do from the view than to take a circular
                    VM dep.
                -->
                <Button Click="SlideshowBtn_Click"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="12,0"
                        ToolTipService.ToolTip="幻灯片">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="16"/>
                        <TextBlock Text="幻灯片" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <Button Grid.Column="1"
                    Click="AboutButton_Click"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="12,0"
                    ToolTipService.ToolTip="关于">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE946;" FontSize="16"/>
                    <TextBlock Text="关于" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!--
            Status chrome overlay. Same pattern as header: RowSpan 3 +
            VerticalAlignment="Bottom". Mouse-near-bottom reveals it in
            fullscreen; everywhere else it stays hidden. Outside
            fullscreen it's pinned visible.
        -->
        <Grid x:Name="StatusChrome"
              Grid.Row="0" Grid.RowSpan="3"
              VerticalAlignment="Bottom"
              Height="32"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              Visibility="{x:Bind StatusVisibility, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                <!-- Scan progress ring. Active while the directory scanner is
                     enumerating the filesystem (typically a few seconds for a
                     Pictures folder, tens of seconds for a whole drive). The
                     StatusText binding next to it shows the running count
                     ("Scanning... 1234 images found") updated by a throttled
                     progress sink in the VM. -->
                <ProgressRing Width="16"
                              Height="16"
                              IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsScanningVisibility, Mode=OneWay}"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0"/>

                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="900"/>

                <!-- Incremental loading button to reduce initial lag while keeping masonry visual -->
                <Button Content="加载更多"
                        Command="{x:Bind ViewModel.LoadMoreCommand}"
                        Visibility="{x:Bind ViewModel.LoadMoreVisibility, Mode=OneWay}"
                        Margin="12,0,0,0"
                        Padding="8,4"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
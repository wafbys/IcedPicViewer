<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IcedPicViewer.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:IcedPicViewer.Core.Text"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">

    <Grid>
        <!--
            Back navigation lives in the window's TitleBar control now
            (IsBackButtonVisible / BackRequested, wired in MainWindow), so
            this page no longer draws its own top bar; the title bar's
            Subtitle shows 「关于」. Esc also goes back via the keyboard
            hook in MainWindow.
        -->
        <ScrollViewer
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="32,24,32,24">
            <StackPanel MaxWidth="780" HorizontalAlignment="Left" Spacing="16">

                <!-- App identity -->
                <TextBlock Text="IcedPicViewer"
                           Style="{StaticResource AppTitleTextBlockStyle}"/>
                <TextBlock x:Name="VersionTextBlock"
                           Style="{StaticResource AppCaptionTextBlockStyle}"
                           Opacity="0.7"/>
                <TextBlock x:Name="IntroTextBlock"
                           TextWrapping="Wrap"
                           Style="{StaticResource AppBodyTextBlockStyle}"/>

                <!-- Thumbnail cache: on-disk usage + clear. Labels come from
                     AboutCopy/UiCopy (Chinese copy lives in Core); the numbers
                     are filled in from IThumbnailDiskCache when the page loads. -->
                <TextBlock Text="{x:Bind core:AboutCopy.CacheSectionTitle}"
                           Style="{StaticResource AppSubtitleTextBlockStyle}"
                           Margin="0,20,0,4"/>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="20">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="CacheDescTextBlock"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource AppBodyTextBlockStyle}"/>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing x:Name="CacheStatsRing"
                                          Width="16"
                                          Height="16"
                                          IsActive="True"
                                          VerticalAlignment="Center"/>
                            <TextBlock x:Name="CacheStatsTextBlock"
                                       Style="{StaticResource AppBodyTextBlockStyle}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button x:Name="ClearCacheButton"
                                Click="ClearCacheButton_Click"
                                IsEnabled="False"
                                Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Third-party section header -->
                <TextBlock Text="{x:Bind core:AboutCopy.ThirdPartySectionTitle}"
                           Style="{StaticResource AppSubtitleTextBlockStyle}"
                           Margin="0,20,0,4"/>

                <!-- FFmpeg card. The card border + background mirrors the
                     gallery's CardBackground/CardStroke scheme so the
                     visual rhythm matches the rest of the app. -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="FFmpeg"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="FfmpegDescTextBlock"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource AppBodyTextBlockStyle}"/>

                        <!-- Runtime truth, filled by AboutPage.RefreshFfmpegStatus:
                             whether the native libraries actually bound in this
                             process (a stale/missing set silently disables video
                             thumbnails, so this line is the visible signal). -->
                        <TextBlock x:Name="FfmpegStatusTextBlock"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource AppBodyTextBlockStyle}"/>

                        <!-- Links. HyperlinkButton with NavigateUri opens
                             external links in the user's default browser.
                             The license link is local (ms-appx), handled
                             in code-behind via Launcher.LaunchFileAsync
                             so the file opens in the user's preferred
                             text editor (Notepad by default on Windows). -->
                        <HyperlinkButton Content="{x:Bind core:AboutCopy.FfmpegHomepageLink}"
                                         NavigateUri="https://ffmpeg.org/"
                                         Padding="0,4,0,4"/>
                        <HyperlinkButton Content="{x:Bind core:AboutCopy.FfmpegBuildsLink}"
                                         NavigateUri="https://github.com/BtbN/FFmpeg-Builds"
                                         Padding="0,4,0,4"/>
                        <HyperlinkButton x:Name="LicenseLink"
                                         Content="{x:Bind core:AboutCopy.LicenseFullTextLink}"
                                         Click="LicenseLink_Click"
                                         Padding="0,4,0,4"/>

                        <TextBlock TextWrapping="Wrap" Style="{StaticResource AppCaptionTextBlockStyle}" Opacity="0.7" Margin="0,8,0,0">
                            <Run Text="LGPL 合规: 7 个 FFmpeg DLL 位于 MSIX 包安装根的固定路径下,用户可以在原地替换以满足 LGPL 的可重新链接要求。获取方式见"/>
                            <Run Text="src\native\ffmpeg\README.md"/>
                            <Run Text="。"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Future: more third-party cards go here (SharpCompress, etc.). -->
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

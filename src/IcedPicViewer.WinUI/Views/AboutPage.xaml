<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IcedPicViewer.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar: back button + title. Mirrors the gallery's top bar
             style so navigation between pages feels consistent. -->
        <Grid Grid.Row="0" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BackButton"
                        Click="BackButton_Click"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="12,0"
                        ToolTipService.ToolTip="Back to gallery">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72B;" FontSize="16"/>
                        <TextBlock Text="Back" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="About"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="32,24,32,24">
            <StackPanel MaxWidth="780" HorizontalAlignment="Left" Spacing="16">

                <!-- App identity -->
                <TextBlock Text="IcedPicViewer"
                           FontSize="32"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="VersionTextBlock"
                           FontSize="13"
                           Opacity="0.7"/>
                <TextBlock TextWrapping="Wrap"
                           FontSize="14">
                    <Run Text="一个基于 WinUI 3 + Windows App SDK 的图片 / 视频查看器。本地优先、纯查看器，不上传、不联网。"/>
                </TextBlock>

                <!-- Third-party section header -->
                <TextBlock Text="第三方组件 / Third-Party Components"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="0,20,0,4"/>

                <!-- FFmpeg card. The card border + background mirrors the
                     gallery's CardBackground/CardStroke scheme so the
                     visual rhythm matches the rest of the app. -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="FFmpeg"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>
                        <TextBlock TextWrapping="Wrap" FontSize="13">
                            <Run Text="版本 8.1 (BtbN 构建,LGPL 2.1+ shared)。用于读取视频文件的元数据 (分辨率、时长、音轨) 和首帧缩略图。"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" FontSize="13" Opacity="0.7">
                            <Run Text="Version 8.1 (BtbN build, LGPL 2.1+ shared). Used for reading video metadata (resolution, duration, audio) and first-frame thumbnails."/>
                        </TextBlock>

                        <!-- Links. HyperlinkButton with NavigateUri opens
                             external links in the user's default browser.
                             The license link is local (ms-appx), handled
                             in code-behind via Launcher.LaunchFileAsync
                             so the file opens in the user's preferred
                             text editor (Notepad by default on Windows). -->
                        <HyperlinkButton Content="FFmpeg 官方网站 (ffmpeg.org)"
                                         NavigateUri="https://ffmpeg.org/"
                                         Padding="0,4,0,4"/>
                        <HyperlinkButton Content="BtbN/FFmpeg-Builds (本项目使用的构建来源)"
                                         NavigateUri="https://github.com/BtbN/FFmpeg-Builds"
                                         Padding="0,4,0,4"/>
                        <HyperlinkButton x:Name="LicenseLink"
                                         Content="LGPL 2.1 许可证全文 (本项目内嵌副本)"
                                         Click="LicenseLink_Click"
                                         Padding="0,4,0,4"/>

                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.7" Margin="0,8,0,0">
                            <Run Text="LGPL 合规: 7 个 FFmpeg DLL 位于 AppX 包的固定路径下,用户可以在原地替换以满足 LGPL 的可重新链接要求。详细构建信息见"/>
                            <Run Text="runtimes\win-x64\native\README.md"/>
                            <Run Text="。"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Future: more third-party cards go here (SharpCompress, etc.). -->
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

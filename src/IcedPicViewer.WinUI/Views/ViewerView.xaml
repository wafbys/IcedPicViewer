<Page
    x:Class="IcedPicViewer.Views.ViewerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:IcedPicViewer"
    xmlns:controls="using:IcedPicViewer.Controls"
    xmlns:core="using:IcedPicViewer.Core.Text"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Dark"
    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">

    <Grid x:Name="MainContentGrid" IsTabStop="True"
          PointerMoved="MainContentGrid_PointerMoved"
          PointerPressed="MainContentGrid_PointerPressed"
          PointerWheelChanged="MainContentGrid_PointerWheelChanged"
          KeyDown="MainContentGrid_KeyDown"
          AllowDrop="True"
          DragOver="MainContentGrid_DragOver"
          Drop="MainContentGrid_Drop">
        <Grid.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem Text="{x:Bind core:UiCopy.RevealInFolder}" Click="OpenFileLocation_Click"/>
                <MenuFlyoutItem Text="{x:Bind core:UiCopy.Delete}" Command="{x:Bind ViewModel.DeleteCommand}"/>
            </MenuFlyout>
        </Grid.ContextFlyout>
        <!--
            Floating CommandBar layout. Row 0 is fixed Height="0" so
            the chrome never reserves vertical space — instead the
            CommandBar takes RowSpan="2" + VerticalAlignment="Top" and
            floats above the image / video content. Showing or hiding
            the bar therefore does NOT resize the content area; the
            user's image stays exactly where it was instead of being
            pushed down by 48 px when the bar appears.

            Background: floating over arbitrary image / video content means
            the bar must supply its own legibility layer — a white photo must
            not wash the white foreground out. AcrylicInAppFillColorDefaultBrush
            is the SDK's in-app acrylic material (the same one the framework
            uses for CommandBarBackgroundOpen and MediaTransportControlsPanelBackground):
            it blurs + tints whatever sits behind the bar, ships dedicated
            Light/Dark values, and degrades to a solid color under High Contrast
            or when transparency effects are off. The gallery header uses the
            same brush so the two toolbars read as one material.
            History: custom lower-opacity variants were tried while the bar
            was pinned visible; now that chrome auto-hides (ChromeHideDelayMs,
            both presenters) the occlusion problem is gone and the standard
            material wins on readability + theme fidelity.
        -->
        <Grid.RowDefinitions>
            <RowDefinition Height="0"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <CommandBar x:Name="ViewerCommandBar"
                    Grid.Row="0" Grid.RowSpan="2"
                    VerticalAlignment="Top"
                    Canvas.ZIndex="100"
                    DefaultLabelPosition="Collapsed"
                    Visibility="{x:Bind CommandBarVisibility, Mode=OneWay}"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
            <CommandBar.Content>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="{x:Bind ViewModel.SelectedItem.Name, Mode=OneWay}"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               Margin="0,0,8,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                    <TextBlock Text="{x:Bind ViewModel.SelectedItem.InfoLine, Mode=OneWay}"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Margin="0,0,8,0"
                               Style="{StaticResource AppCaptionTextBlockStyle}"/>
                    <TextBlock Text="{x:Bind ViewModel.ImagePath, Mode=OneWay}"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Style="{StaticResource AppCaptionTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                </StackPanel>
            </CommandBar.Content>
            <AppBarButton Icon="Cancel"
                          Label="{x:Bind core:UiCopy.Close}"
                          Command="{x:Bind ViewModel.CloseCommand}"
                          ToolTipService.ToolTip="{x:Bind core:UiCopy.Close}"/>
            <AppBarSeparator/>
            <AppBarButton Icon="Previous"
                          Label="{x:Bind core:UiCopy.Previous}"
                          Command="{x:Bind ViewModel.NavigatePreviousCommand}"
                          ToolTipService.ToolTip="{x:Bind core:UiCopy.Previous}"/>
            <AppBarElementContainer>
                <TextBlock VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           Margin="4,0">
                    <Run Text="{x:Bind ViewModel.DisplayIndex, Mode=OneWay}"/>
                    <Run Text="/"/>
                    <Run Text="{x:Bind ViewModel.ItemCount, Mode=OneWay}"/>
                </TextBlock>
            </AppBarElementContainer>
            <AppBarButton Icon="Next"
                          Label="{x:Bind core:UiCopy.Next}"
                          Command="{x:Bind ViewModel.NavigateNextCommand}"
                          ToolTipService.ToolTip="{x:Bind core:UiCopy.Next}"/>
            <AppBarSeparator/>
            <!--
                Fit/1:1 toggle now works for both images and videos.
                For images: toggles between Viewbox (Fit) and ScrollViewer
                with the minimap (1:1). For videos: toggles between
                MediaPlayerElement.Stretch=Uniform (Fit) and Stretch=None
                inside a ScrollViewer (1:1, native resolution). Visibility
                stays Visible for both kinds — the user always gets the
                same affordance.
            -->
            <AppBarButton x:Name="FitModeBtn"
                          Icon="Zoom"
                          Label="{x:Bind core:UiCopy.Fit}"
                          Click="FitModeBtn_Click"
                          ToolTipService.ToolTip="{x:Bind core:UiCopy.FitToggleTooltip}"/>
            <AppBarButton Icon="Refresh"
                          Label="{x:Bind core:UiCopy.LoadMore}"
                          Command="{x:Bind ViewModel.LoadMoreCommand}"
                          Visibility="{x:Bind ViewModel.LoadMoreVisibility, Mode=OneWay}"
                          ToolTipService.ToolTip="{x:Bind core:UiCopy.LoadMore}"/>
            <!--
                Slideshow toggle. Click to start / stop the auto-advance
                timer. Glyph + label + tooltip all switch on
                IsSlideshowActive so the user can tell at a glance
                whether the slideshow is running. While running, the
                timer fires every SlideshowInterval and calls
                NavigateNextCommand — Next is also bound to the
                arrow key, so the manual and auto paths share the
                same CanExecute / state.
            -->
            <AppBarButton Label="{x:Bind ViewModel.SlideshowLabel, Mode=OneWay}"
                          Command="{x:Bind ViewModel.SlideshowCommand}"
                          ToolTipService.ToolTip="{x:Bind ViewModel.SlideshowTooltip, Mode=OneWay}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="{x:Bind ViewModel.SlideshowGlyph, Mode=OneWay}"/>
                </AppBarButton.Icon>
            </AppBarButton>
            <!--
                Loop and Shuffle toggles. AppBarToggleButton (not
                AppBarButton) is the right primitive here — the user
                expects the button to *stay* in the toggled state with
                visible feedback, and ToggleButton's IsChecked flips
                automatically on click. We bind IsChecked TwoWay to
                IsSlideshowLooping / IsSlideshowShuffling so the
                click-to-flip is the entire state-change path; no
                Click handler is needed (and removing it means
                there's no chance of a double-toggle from button +
                handler both firing). WinUI's ToggleButton default
                style includes a visible "checked" highlight
                (background tint), which is the visual state change
                the user asked for. Tooltip + label continue to flip
                so the meaning is clear even when the highlight
                isn't obvious (custom themes, low contrast, etc.).
            -->
            <AppBarToggleButton Label="{x:Bind ViewModel.SlideshowLoopLabel, Mode=OneWay}"
                                IsChecked="{x:Bind ViewModel.IsSlideshowLooping, Mode=TwoWay}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.SlideshowLoopTooltip, Mode=OneWay}">
                <AppBarToggleButton.Icon>
                    <FontIcon Glyph="{x:Bind ViewModel.SlideshowLoopGlyph, Mode=OneWay}"/>
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <AppBarToggleButton Label="{x:Bind ViewModel.SlideshowShuffleLabel, Mode=OneWay}"
                                IsChecked="{x:Bind ViewModel.IsSlideshowShuffling, Mode=TwoWay}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.SlideshowShuffleTooltip, Mode=OneWay}">
                <AppBarToggleButton.Icon>
                    <FontIcon Glyph="{x:Bind ViewModel.SlideshowShuffleGlyph, Mode=OneWay}"/>
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <!--
                Auto-advance interval. TwoWay bind to the VM's
                SlideshowInterval (double, seconds) so dragging the
                slider writes through to the timer — the partial
                method OnSlideshowIntervalChanged re-arms a running
                slideshow on the new cadence immediately. The "s"
                suffix + the value label are separate TextBlocks
                (instead of one) so the "s" stays right-aligned to
                the slider thumb and the value text uses its own
                invariant-culture "0.#" format regardless of the
                user's locale. Width 120 px is wide enough to read
                "10" / "30" but doesn't dominate the CommandBar.
                AppBarElementContainer wraps the inner StackPanel
                because CommandBar.PrimaryCommands is typed as
                ICommandBarElement — raw FrameworkElements aren't
                accepted.
            -->
            <AppBarElementContainer>
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                            Margin="8,0,0,0">
                    <TextBlock Text="间隔:"
                               VerticalAlignment="Center"
                               Style="{StaticResource AppCaptionTextBlockStyle}"
                               Opacity="0.7"/>
                    <Slider x:Name="SlideshowIntervalSlider"
                            Minimum="1"
                            Maximum="30"
                            Value="{x:Bind ViewModel.SlideshowInterval, Mode=TwoWay}"
                            Width="120"
                            VerticalAlignment="Center"
                            StepFrequency="0.5"
                            SmallChange="0.5"
                            LargeChange="5"
                            ToolTipService.ToolTip="幻灯片间隔（秒）"/>
                    <TextBlock Text="{x:Bind ViewModel.SlideshowIntervalText, Mode=OneWay}"
                               VerticalAlignment="Center"
                               Style="{StaticResource AppCaptionTextBlockStyle}"
                               MinWidth="28"
                               TextAlignment="Right"/>
                    <TextBlock Text="秒"
                               VerticalAlignment="Center"
                               Style="{StaticResource AppCaptionTextBlockStyle}"
                               Opacity="0.7"/>
                </StackPanel>
            </AppBarElementContainer>
            <AppBarSeparator/>
            <!--
                Fullscreen toggle. Glyph swaps between FullScreen (⛶)
                and BackToWindow (⤢) based on IsFullscreen, which is
                itself a live read of App.MainWindow.IsFullscreen so
                it stays correct after F11 toggles the presenter from
                outside the view. F11 keyboard shortcut fires the same
                ToggleFullscreen method via the WH_KEYBOARD hook in
                MainWindow.HandleViewerKey.
            -->
            <AppBarButton Label="{x:Bind IsFullscreenLabel, Mode=OneWay}"
                          Click="FullscreenBtn_Click"
                          ToolTipService.ToolTip="{x:Bind IsFullscreenTooltip, Mode=OneWay}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="{x:Bind IsFullscreenGlyph, Mode=OneWay}"/>
                </AppBarButton.Icon>
            </AppBarButton>
            <CommandBar.SecondaryCommands>
                <AppBarButton Icon="OpenFile"
                              Label="{x:Bind core:UiCopy.RevealInFolder}"
                              Click="OpenFileLocation_Click"
                              ToolTipService.ToolTip="{x:Bind core:UiCopy.RevealInFolderTooltip}"/>
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <!--
            Two content surfaces share the same Grid.Row="1" so they occupy
            the same area; visibility on their parent Grids (ImageHost /
            PlayerHost) decides which one is on screen. The split mirrors
            the user spec "默认静态首帧 + ▶,点才创建 MediaPlayerElement":
            the image surface (Viewbox + ScrollViewer + minimap) handles
            the static case, the player surface handles the playing case,
            and they're never both visible at once.
        -->
        <Grid x:Name="ImageHost"
              Grid.Row="1"
              Visibility="{x:Bind ViewModel.ImageHostVisibility, Mode=OneWay}">
            <Viewbox x:Name="FitContainer" Stretch="Uniform">
                <Image x:Name="FitImage"
                       Source="{x:Bind ViewModel.DisplayImage, Mode=OneWay}"
                       Stretch="Uniform"
                       ImageOpened="FitImage_ImageOpened"
                       AutomationProperties.Name="{x:Bind ViewModel.SelectedItem.Name, Mode=OneWay}"/>
            </Viewbox>

            <ScrollViewer x:Name="ActualSizeContainer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          ViewChanged="ActualSizeContainer_ViewChanged"
                          SizeChanged="ActualSizeContainer_SizeChanged"
                          Visibility="Collapsed">
                <Image x:Name="ActualSizeImage" Source="{x:Bind ViewModel.DisplayImage, Mode=OneWay}"
                       Stretch="None"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Loaded="ActualSizeImage_Loaded"
                       ImageOpened="ActualSizeImage_ImageOpened"/>
            </ScrollViewer>

            <Grid x:Name="MinimapOverlay"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Margin="0,0,16,16" Visibility="Collapsed">
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4" Padding="4">
                    <Grid>
                        <Image x:Name="MinimapImage" Stretch="Uniform" />
                        <!--
                            MinimapViewport is the pointer target (not MinimapImage).
                            Reasoning: Image.Stretch=Uniform leaves transparent padding
                            around the picture, and a moving mouse over that padding
                            never reached Image.PointerMoved. With Background="Transparent"
                            the Canvas hit-tests its full 150x120 area, and routed
                            events bubble up here from the viewport Rectangle too.
                        -->
                        <Canvas x:Name="MinimapViewport"
                                Background="Transparent"
                                Width="150" Height="120"
                                PointerPressed="MinimapImage_PointerPressed"
                                PointerMoved="MinimapImage_PointerMoved"
                                PointerReleased="MinimapImage_PointerReleased"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid x:Name="PlayerHost"
              Grid.Row="1"
              Visibility="{x:Bind ViewModel.PlayerHostVisibility, Mode=OneWay}">
            <!--
                Static first frame behind the play overlay. Same source as
                the gallery's Thumbnail, so the user sees the same picture
                they tapped on — no surprise reload. Visibility stays
                Visible even while the player is rendering on top; the
                MediaPlayerElement's surface is opaque so the underlying
                Image is hidden in practice.
            -->
            <Image Source="{x:Bind ViewModel.DisplayImage, Mode=OneWay}"
                   Stretch="Uniform"/>
            <!--
                LibVLC soft-render surface for codecs MF cannot play
                (VP8/WebM, ProRes, …).
            -->
            <controls:VlcImageSurface x:Name="VlcSurface"
                                      MediaPlayer="{x:Bind ViewModel.VlcPlayer, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.VlcSurfaceVisibility, Mode=OneWay}"/>
            <!--
                Loading indicator during playback preparation. Shown while
                PlayAsync is waiting on the FFmpeg remux / extract step,
                which can take several seconds for large non-MP4 files on
                slow storage. Centered on the static first frame so the
                user knows something is happening and doesn't click ▶
                repeatedly.
            -->
            <StackPanel Visibility="{x:Bind ViewModel.IsVideoPreparingVisibility, Mode=OneWay}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="12">
                <ProgressRing IsActive="True"
                              Width="48" Height="48"
                              HorizontalAlignment="Center"/>
                <TextBlock Text="{x:Bind core:UiCopy.PreparingVideo}"
                           FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
            <!--
                Centered play button. Visible only when IsVideo is true AND
                IsVideoPlaying is false — once playback starts, the
                MediaPlayerElement takes over and the built-in transport
                controls (play/pause/scrubber) own the chrome. Background
                is a fixed semi-opaque black for the same reason as the
                gallery card ▶: it has to read clearly on any first
                frame, regardless of the video's dominant colour.
            -->
            <Button x:Name="PlayOverlay"
                    Visibility="{x:Bind ViewModel.IsPlayOverlayVisibility, Mode=OneWay}"
                    Click="PlayOverlay_Click"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#CC000000"
                    BorderThickness="0"
                    Width="80" Height="80"
                    CornerRadius="40"
                    Padding="0"
                    ToolTipService.ToolTip="{x:Bind core:UiCopy.PlayTooltip}">
                <FontIcon Glyph="&#xE768;" FontSize="36" Foreground="White"/>
            </Button>
            <!--
                Pre-playback control strip. Pinned to the bottom of
                PlayerHost, visible only while IsVideo && !IsVideoPlaying.
                Three columns: play button (secondary ▶, mirrors the
                centre PlayOverlay so the user has a hit target at the
                bottom edge too), filename + duration label, volume
                slider. The volume slider is the main reason this strip
                exists — without it the user has no way to lower volume
                before pressing play, and MediaPlayerElement's built-in
                transport controls only appear AFTER playback starts,
                making them useless for "set volume then play" UX.
                Once playback starts the strip collapses and the
                MediaPlayerElement's built-in transport controls take
                over (in Fit mode) or the 1:1 mode custom strip takes
                over (in native-resolution mode).

                Background: same material and rationale as the viewer CommandBar
                above — the strip floats over the static first frame (which
                can be arbitrarily bright), so it uses the same standard
                acrylic brush.
            -->
            <Grid x:Name="PrePlayStrip"
                  Visibility="{x:Bind ViewModel.PrePlayStripVisibility, Mode=OneWay}"
                  VerticalAlignment="Bottom"
                  Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                  BorderThickness="0,1,0,0"
                  Padding="12,8"
                  ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Click="PlayOverlay_Click"
                        VerticalAlignment="Center"
                        Padding="8,4"
                        ToolTipService.ToolTip="{x:Bind core:UiCopy.PlayTooltip}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE768;" FontSize="14"/>
                        <TextBlock Text="{x:Bind core:UiCopy.Play}"/>
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.SelectedItem.Name, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1"
                               Style="{StaticResource AppBodyTextBlockStyle}"/>
                    <TextBlock Text="{x:Bind ViewModel.PrePlayDurationText, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{StaticResource AppBodyTextBlockStyle}"/>
                </StackPanel>
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="6"
                            MinWidth="180">
                    <!--
                        Mute toggle. Lives here (not only in the player's own
                        transport controls) because those only exist after playback
                        starts — "set it up, then press play" needs a mute before
                        that, and the icon doubles as the mute state readout.
                    -->
                    <Button x:Name="PrePlayMuteButton"
                            Command="{x:Bind ViewModel.ToggleMuteCommand}"
                            VerticalAlignment="Center"
                            Padding="6"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTipService.ToolTip="{x:Bind ViewModel.MuteTooltip, Mode=OneWay}">
                        <FontIcon Glyph="{x:Bind ViewModel.MuteGlyph, Mode=OneWay}"
                                  FontSize="14"/>
                    </Button>
                    <Slider x:Name="PrePlayVolumeSlider"
                            Value="{x:Bind ViewModel.Volume, Mode=TwoWay}"
                            Minimum="0"
                            Maximum="1"
                            StepFrequency="0.01"
                            SmallChange="0.01"
                            LargeChange="0.1"
                            VerticalAlignment="Center"
                            MinWidth="120"
                            ToolTipService.ToolTip="{x:Bind core:UiCopy.Volume}"/>
                    <TextBlock Text="{x:Bind ViewModel.VolumePercent, Mode=OneWay}"
                               VerticalAlignment="Center"
                               Style="{StaticResource AppCaptionTextBlockStyle}"
                               MinWidth="36"
                               TextAlignment="Right"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>
            <!--
                Two containers for the MediaPlayerElement. The element
                itself is initially in PlayerFitContainer; when the
                user toggles to 1:1 mode the view's code-behind
                reparents it into PlayerScrollViewer (and back when
                they return to Fit). Reparenting is needed because:

                - A ScrollViewer always offers infinite layout space to
                  its child, which is the right behaviour for 1:1
                  mode (native resolution is larger than the viewport,
                  the ScrollViewer allows panning) but the wrong
                  behaviour for Fit mode (Uniform stretch needs a
                  finite viewport to know what to scale to — inside
                  a ScrollViewer the element ends up at the video's
                  natural size, not scaled to fit).
                - A Grid gives the element a finite layout slot, which
                  is right for Fit mode (Uniform stretches correctly)
                  but offers no scroll affordance for 1:1 mode.

                Two containers + reparenting gives each mode the host
                it needs without paying for a complex Grid+ScrollViewer
                stack or a custom canvas. Visibility on the containers
                is gated by IsVideo && IsFitMode (or !IsFitMode) &&
                IsVideoPlaying, so the element is only ever laid out
                when there's actually a player to render — preventing
                the v0.14.2 "no media" state that blocked pointer
                events on the PlayOverlay button.

                The ScrollViewer's scroll modes are fixed at Auto
                (not bound) because the ScrollViewer itself is only
                Visible in 1:1 mode — in Fit mode it's Collapsed and
                its scroll mode is irrelevant. Hardcoding here
                removes a binding round-trip without changing
                behaviour.
            -->
            <Grid x:Name="PlayerFitContainer"
                  Visibility="{x:Bind ViewModel.PlayerFitContainerVisibility, Mode=OneWay}">
                <MediaPlayerElement x:Name="Player"
                                    AreTransportControlsEnabled="{x:Bind ViewModel.PlayerUseBuiltInControls, Mode=OneWay}"
                                    Stretch="{x:Bind ViewModel.PlayerStretch, Mode=OneWay}"/>
            </Grid>
            <!--
                1:1 host: outer Grid with two rows. Row 0 is a
                ScrollViewer (which the Player is reparented into); row 1
                is a custom transport-controls strip pinned to the
                bottom of the container. The strip owns the
                play/pause / seek / time-display UI in 1:1 mode so
                the controls are always reachable, even when the
                ScrollViewer is showing only the top edge of the
                1920x1080 frame. AreTransportControlsEnabled is
                False in this mode (the MediaPlayerElement is the
                video source only, the chrome lives outside the
                element).
            -->
            <Grid x:Name="PlayerActualSizeContainer"
                  Visibility="{x:Bind ViewModel.PlayerActualSizeContainerVisibility, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer x:Name="PlayerScrollViewerInner"
                              Grid.Row="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Auto"
                              VerticalScrollMode="Auto"/>
                <Grid x:Name="PlayerControlsStrip"
                      Grid.Row="1"
                      Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                      Padding="8,4"
                      ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PlayPauseBtn"
                            Grid.Column="0"
                            Click="PlayPauseBtn_Click"
                            ToolTipService.ToolTip="{x:Bind core:UiCopy.PlayPauseTooltip}">
                        <FontIcon x:Name="PlayPauseGlyph" Glyph="&#xE768;"/>
                    </Button>
                    <Slider x:Name="PositionSlider"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Minimum="0"
                            Maximum="100"
                            Value="0"
                            StepFrequency="1"
                            SmallChange="1"
                            LargeChange="10"
                            PointerEntered="PositionSlider_PointerEntered"
                            PointerExited="PositionSlider_PointerExited"
                            ValueChanged="PositionSlider_ValueChanged"/>
                    <TextBlock x:Name="TimeText"
                               Grid.Column="2"
                               Text="0:00 / 0:00"
                               VerticalAlignment="Center"
                               Style="{StaticResource AppCaptionTextBlockStyle}"
                               MinWidth="90"
                               TextAlignment="Right"/>
                </Grid>
            </Grid>
        </Grid>

        <!--
            Edge navigation buttons (Windows Photos style). Pinned to the
            vertical centre of each side so the whole left/right edge is a
            "previous / next" affordance reachable without the keyboard.

            Visibility is its own state (EdgePrevVisibility / EdgeNextVisibility):
            arrows appear on any mouse movement in the viewer and fade after the
            same idle delay the chrome uses, then also require the matching
            command to be executable — so no arrow is ever shown with nothing to
            go to. They deliberately do NOT follow the command bar's visibility:
            the bar only reveals near the top edge, and an arrow you cannot bring
            up by moving toward it would be useless.

            Scrim #CC000000 mirrors the play overlay: it must read against any
            frame, and the page is forced to the dark theme anyway. The right
            arrow is inset 16 px so it never covers the 1:1 mode scrollbar.
        -->
        <Button x:Name="EdgePrevButton"
                Grid.Row="1"
                Command="{x:Bind ViewModel.NavigatePreviousCommand}"
                HorizontalAlignment="Left" VerticalAlignment="Center"
                Margin="16,0,0,0"
                Width="48" Height="48" CornerRadius="24" Padding="0"
                Background="#CC000000" BorderThickness="0"
                Canvas.ZIndex="50"
                IsTabStop="False"
                Visibility="{x:Bind EdgePrevVisibility, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind core:UiCopy.Previous}"
                AutomationProperties.Name="{x:Bind core:UiCopy.Previous}">
            <FontIcon Glyph="&#xE76B;" FontSize="20" Foreground="White"/>
        </Button>
        <Button x:Name="EdgeNextButton"
                Grid.Row="1"
                Command="{x:Bind ViewModel.NavigateNextCommand}"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                Margin="0,0,16,0"
                Width="48" Height="48" CornerRadius="24" Padding="0"
                Background="#CC000000" BorderThickness="0"
                Canvas.ZIndex="50"
                IsTabStop="False"
                Visibility="{x:Bind EdgeNextVisibility, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind core:UiCopy.Next}"
                AutomationProperties.Name="{x:Bind core:UiCopy.Next}">
            <FontIcon Glyph="&#xE76C;" FontSize="20" Foreground="White"/>
        </Button>

        <ProgressRing Grid.Row="1"
                      IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Width="48"
                      Height="48"/>
        <!--
            Pinned error hint — custom panel, not InfoBar.

            The earlier InfoBar implementation had two issues the
            user called out:
              1. It looked out of place in the app (default red
                 severity chrome doesn't match the dark gallery UI).
              2. It capped the message height at 180 px with an
                 internal scrollbar — Microsoft's own InfoBar docs
                 (https://learn.microsoft.com/en-us/windows/apps/design/controls/info-bar)
                 say it's designed for 1-2 line alerts and explicitly
                 recommend ContentDialog for "long messages or
                 detailed content". We have 8-15 line codec hints,
                 which is the exact case InfoBar warns against — the
                 scrollbar was a forced workaround for using the
                 wrong control.

            This replacement is a plain Border styled to fit the
            app's chrome: subtle dark background (same theme brush
            the rest of the UI uses), thin red accent border, dark
            primary text. The message is a TextBlock with
            IsTextSelectionEnabled=True — no MaxHeight, no scroll,
            no truncation. TextBlock selection supports
            mouse-drag / double-click-word / triple-click-paragraph /
            Ctrl+A / Ctrl+C out of the box, so the explicit copy
            button becomes the "one-click, full text" path while
            the TextBlock is the "drag to grab a substring" path.

            Visibility tied to VM.IsErrorBarVisibility (projected
            from IsErrorBarOpen). Cleared on navigation by
            OnSelectedItemChanged, same as before.
        -->
        <Border x:Name="ErrorPanel"
                Grid.Row="0" Grid.RowSpan="2"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="16,56,16,0"
                MaxWidth="720"
                Padding="14"
                CornerRadius="6"
                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                BorderThickness="1"
                Canvas.ZIndex="200"
                Visibility="{x:Bind ViewModel.IsErrorBarVisibility, Mode=OneWay}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Text="{x:Bind core:VideoPlaybackCopy.CannotPlayTitle}"
                               x:Name="CannotPlayTitle"
                               Style="{StaticResource AppBodyStrongTextBlockStyle}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True"
                               Style="{StaticResource AppBodyTextBlockStyle}"/>
                </StackPanel>
                <Button Grid.Column="1"
                        x:Name="CopyErrorBtn"
                        Click="CopyErrorBtn_Click"
                        VerticalAlignment="Top"
                        ToolTipService.ToolTip="{x:Bind core:UiCopy.CopyErrorTooltip}">
                    <StackPanel x:Name="CopyBtnContent" Orientation="Horizontal" Spacing="6">
                        <FontIcon x:Name="CopyBtnGlyph" Glyph="&#xE8C8;" FontSize="14"/>
                        <TextBlock x:Name="CopyBtnLabel" Text="{x:Bind core:UiCopy.Copy}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>

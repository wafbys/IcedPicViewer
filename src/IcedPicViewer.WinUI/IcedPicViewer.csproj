<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
    <RootNamespace>IcedPicViewer</RootNamespace>
    <!--
      Single source of truth for the app version. Flows into the assembly
      version, the MSIX package version (see Package.appxmanifest, which must
      stay in sync) and the window title (via Generated/BuildInfo.g.cs).
    -->
    <Version>0.16.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <!-- Only x64 architecture is supported for this project -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Embed AppIcon.ico as the .exe Win32 icon resource so Windows shows
         this app's icon in the taskbar and Alt+Tab. Without this, the
         .exe ships with a generic icon and the taskbar shows the default
         app silhouette. Assets\AppIcon.ico is already listed as Content
         above for MSIX manifest reference; this line additionally
         embeds it in the PE resource. -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      AllowUnsafeBlocks: FFmpeg.AutoGen requires `unsafe` blocks for native
      pointer interop. Only FFmpegProbeService.cs (gated by IPV_FFMPEG_PROBE
      env var) uses this — production code paths do not.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- 完全删除多语言支持：不包含任何 satellite resources（af-ZA 等所有 xx-XX 文件夹）。
         本应用无自定义本地化资源（无 .resw），框架语言包对发布体积无益，全部剥离。 -->
    <SatelliteResourceLanguages></SatelliteResourceLanguages>

    <!-- Code Quality Analyzers -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- IDE style rules stay as suggestions in .editorconfig; do not promote to warnings in build. -->
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- CsWinRT: false positives in this project. Our HashSet<string>, ServiceCollection, etc.
         are never marshaled across the WinRT ABI; these are internal-only types. -->
    <NoWarn>$(NoWarn);CsWinRT1028;CsWinRT1030</NoWarn>
    <!-- SYSLIB1054 suggests LibraryImport (source-generated P/Invoke) over DllImport.
         We use DllImport for the native WndProc subclass hooks (SetWindowSubclass,
         DefSubclassProc) and for the legacy MessageBoxW fallback. Both are internal-only
         and never cross a marshalling boundary, so source-gen AOT benefits don't apply. -->
    <NoWarn>$(NoWarn);SYSLIB1054</NoWarn>
    <!-- CA2020 warns that (int)IntPtr cast doesn't throw on overflow in unchecked context.
         MainWindow's WH_KEYBOARD hook explicitly uses this cast to avoid an
         OverflowException from IntPtr.ToInt32() (which DOES throw on .NET 6+ when
         the IntPtr value is out of int range — observed in practice on Win11 25H2
         + MSIX packaged, where the OS hands us wParam/lParam with garbage high bits).
         The unchecked truncation is exactly what we want here. -->
    <NoWarn>$(NoWarn);CA2020</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Icon assets under Assets\ are generated at build time by the
      GenerateIconAssets target below. The SDK's default
      <EnableDefaultContentItems> already pulls in *.png / *.ico under
      the project root, so no explicit <Content Include> entries are
      needed. Designer can replace the generated files directly to ship
      real art; the target re-creates them on the next build.
    -->
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <!--
      固定版本号 — SDK/runtime 必须严格对应:
      Microsoft.WindowsAppSDK 2.5.x ↔ 目标机 Windows App Runtime 2.5
      (MSIX 会依赖 framework package；跨主版本会启动失败)
    -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0-rc.1.26425.128" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <!--
      WinApp CLI: hooks `dotnet run` for packaged WinUI (debug package identity).
      Bump when console prints "vX.Y is available" from winappcli.
    -->
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.6.1" />

    <!-- Archive via Core (SharpCompress); no direct package needed here. -->

    <!--
      FFmpeg.AutoGen: managed bindings only. Native DLLs are NOT in git —
      run tools/Fetch-FFmpegNatives.ps1 -Rid win-x64, which fills
      src/native/ffmpeg/win-x64. The CopyFFmpegDllsToOutDir target below is
      what places them in the output root.
    -->
    <PackageReference Include="FFmpeg.AutoGen" Version="8.1.0" />

    <!--
      LibVLC: playback fallback when Media Foundation cannot decode
      (VP8/WebM, ProRes, …). Soft-rendered via VlcImageSurface (no HWND VideoView).
    -->
    <PackageReference Include="LibVLCSharp" Version="3.9.3" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />

    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.302">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IcedPicViewer.Core\IcedPicViewer.Core.csproj" />
  </ItemGroup>

  <!--
    FFmpeg LGPL 2.1 license text. The default .NET SDK content globs
    do not pick up the License/ folder under this project (WinUI 3
    projects opt out of the full default glob in some configurations
    and only include Assets/, Views/, and a few well-known patterns).
    The About page opens this file via
    `StorageFile.GetFileFromApplicationUriAsync(new Uri("ms-appx:///License/ffmpeg-LGPL.txt"))`,
    so the file must be present in the package layout at the same
    relative path. PreserveNewest is sufficient — the file rarely
    changes once written and we want a fast incremental build.
  -->
  <ItemGroup>
    <Content Include="License\**\*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    CopyFFmpegDllsToOutDir: WinAppSDK 2.x MSIX packaging does NOT pick up
    files placed under runtimes/<rid>/native/ as direct package payload.
    FFmpeg's LoadLibrary("avcodec-62") must find the DLLs at the package
    install directory root, not in a runtimes/<rid>/native/ subfolder.

    This target copies the FFmpeg DLLs flat into the output root ($(OutDir)),
    which is also the MSIX install root, so the app's process can
    LoadLibrary them at startup. Runs AfterBuild (debug + release).
  -->
  <Target Name="CopyFFmpegDllsToOutDir" AfterTargets="Build" Condition="'$(_DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_FFmpegSourceDir>$(MSBuildProjectDirectory)\..\native\ffmpeg\win-x64\</_FFmpegSourceDir>
    </PropertyGroup>
    <ItemGroup>
      <_FFmpegDlls Include="$(_FFmpegSourceDir)*.dll" />
    </ItemGroup>
    <Warning Code="IPV001"
             Text="FFmpeg native DLLs not found under src/native/ffmpeg/win-x64. Video thumbs/probe will fail. Run: ./tools/Fetch-FFmpegNatives.ps1 -Rid win-x64"
             Condition="@(_FFmpegDlls) == ''" />
    <Copy SourceFiles="@(_FFmpegDlls)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="@(_FFmpegDlls) != ''" />
    <Message Text="CopyFFmpegDllsToOutDir: copied @(_FFmpegDlls) -&gt; $(OutDir)" Importance="high" Condition="@(_FFmpegDlls) != ''" />
  </Target>

  <!--
    CopyLicenseToOutDir: WinAppSDK 2.x MSIX layout only auto-includes
    well-known subdirectories (Assets/, Views/, runtimes/, Microsoft.UI.Xaml/).
    License\ — which holds the LGPL 2.1 text opened from the About page
    via ms-appx:///License/ffmpeg-LGPL.txt — would be silently dropped
    from the package payload even though the <Content> item above puts the
    file in the build output root. Copy it into the output root explicitly
    so the URI resolves at runtime.

    Without this, the About page's license link throws because
    StorageFile.GetFileFromApplicationUriAsync can't find the file
    inside the package install location.
  -->
  <Target Name="CopyLicenseToOutDir" AfterTargets="Build" Condition="'$(_DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_LicenseSourceDir>$(MSBuildProjectDirectory)\License\</_LicenseSourceDir>
      <_LicenseOutDir>$(OutDir)License\</_LicenseOutDir>
    </PropertyGroup>
    <ItemGroup>
      <_LicenseFiles Include="$(_LicenseSourceDir)**\*" />
    </ItemGroup>
    <MakeDir Directories="$(_LicenseOutDir)" Condition="!Exists('$(_LicenseOutDir)')" />
    <Copy SourceFiles="@(_LicenseFiles)" DestinationFiles="@(_LicenseFiles->'$(_LicenseOutDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Message Text="CopyLicenseToOutDir: copied @(_LicenseFiles) -&gt; $(_LicenseOutDir)" Importance="high" Condition="@(_LicenseFiles) != ''" />
  </Target>

  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!--
    WinUI 3 app, MSIX-packaged (WindowsPackageType is unset → defaults to MSIX).
    Package.appxmanifest + WASDK 2.5.x declare the framework dependency on
    Microsoft.WindowsAppRuntime 2.5, which Windows resolves from the framework
    package.

    Build / Run flow (this project is never packaged for distribution):
      - `dotnet build -c Debug -p:Platform=x64` produces the layout at
        bin\$(Platform)\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\
      - `dotnet run` (via Microsoft.Windows.SDK.BuildTools.WinApp, added above)
        registers a debug package identity (AUMID) and launches the app.
        This is the only supported way to start it — see the .exe caveat below.
  -->
  <PropertyGroup>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishDir>bin\$(Platform)\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish\</PublishDir>
  </PropertyGroup>

  <!--
    Regenerate placeholder icon assets in Assets\ before every build.
    Outputs a monogram "I" mark (rounded square + bold white "I") at all
    sizes required by Package.appxmanifest and the Windows shell (Store
    Logo 50, Square44x44 base+scale-200+targetsize-24/48, Square150x150
    base+scale-200, Wide310x150 base+scale-200, SplashScreen base+scale-200,
    LockScreenLogo scale-200) plus a multi-size AppIcon.ico (16/24/32/48/
    64/128/256).

    This overwrites the Visual Studio template default placeholders
    (gray X frame PNGs + the picture-frame blue .ico) so the app has
    a coherent brand mark from the first build. A designer can replace
    the generated files directly; the target re-creates them on the next
    build only if you delete them (a stamp file tracks the last run).

    _DesignTimeBuild skip avoids running during IDE design-time XAML
    reloads, which would race with file watchers.
  -->
  <Target Name="GenerateIconAssets" BeforeTargets="BeforeBuild" Condition="'$(_DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_IconScript>$(MSBuildProjectDirectory)\Tools\GenerateIconAssets.ps1</_IconScript>
      <_IconAssetsDir>$(MSBuildProjectDirectory)\Assets\</_IconAssetsDir>
      <_IconStampDir>$(BaseIntermediateOutputPath)</_IconStampDir>
      <_IconStamp>$(BaseIntermediateOutputPath)GenerateIconAssets.stamp</_IconStamp>
    </PropertyGroup>
    <MakeDir Directories="$(_IconStampDir)" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(_IconScript)&quot; -AssetsDir &quot;$(_IconAssetsDir)&quot;" />
    <WriteLinesToFile File="$(_IconStamp)" Lines="" Overwrite="true" WriteOnlyWhenDifferent="false" />
  </Target>

  <!--
    Embed the current git short commit hash into the assembly so the window
    title can display it at runtime. The hash is captured at build time (not
    at run time) so the displayed version always matches the running binary,
    and so the app doesn't need a .git directory on the user's machine.

    The generated file is written into the project's Generated/ folder so the
    SDK's default <Compile Include="**/*.cs" /> picks it up automatically —
    no need to manually wire it into the Compile item group. .gitignore
    excludes Generated/ so it never gets tracked.

    The const is used by MainWindow to set AppTitleBar.Title /
    AppWindow.Title at startup.

    Falls back to "unknown" when git is unavailable or the repo has no
    commits (e.g. fresh build server clone). _DesignTimeBuild skip avoids
    running git during IDE design-time XAML reloads.
  -->
  <Target Name="GenerateBuildInfo" BeforeTargets="BeforeBuild" Condition="'$(_DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_GeneratedDir>$(MSBuildProjectDirectory)\Generated\</_GeneratedDir>
      <_BuildInfoPath>$(_GeneratedDir)BuildInfo.g.cs</_BuildInfoPath>
    </PropertyGroup>
    <MakeDir Directories="$(_GeneratedDir)" />
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitShortHash" />
    </Exec>
    <PropertyGroup>
      <_GitShortHash>$(_GitShortHash.Trim())</_GitShortHash>
      <_GitShortHash Condition="'$(_GitShortHash)' == ''">unknown</_GitShortHash>
    </PropertyGroup>
    <ItemGroup>
      <_BuildInfoLines Include="// Auto-generated by build. Do not edit." />
      <_BuildInfoLines Include="namespace IcedPicViewer" />
      <_BuildInfoLines Include="{" />
      <_BuildInfoLines Include="    internal static class BuildInfo" />
      <_BuildInfoLines Include="    {" />
      <!--
        %3B escapes the trailing semicolon — MSBuild parses attribute values
        with `;` as list separators, so a literal `;` here would be silently
        dropped and the file would be syntactically broken.
      -->
      <_BuildInfoLines Include="        public const string CommitShort = &quot;$(_GitShortHash)&quot;%3B" />
      <!--
        Configuration is emitted from the actual build configuration rather than
        read from #if DEBUG, so the string can never disagree with the binary.
      -->
      <_BuildInfoLines Include="        public const string Configuration = &quot;$(Configuration)&quot;%3B" />
      <_BuildInfoLines Include="        public const string Version = &quot;$(Version)&quot;%3B" />
      <!--
        Pre-composed for the window title / About page so the two never drift.
        Kept short on purpose: Windows 11 shows AppWindow.Title next to the
        taskbar icon, so this should stay short enough not to truncate.
      -->
      <_BuildInfoLines Include="        public const string DisplayVersion = &quot;$(Version) ($(Configuration))&quot;%3B" />
      <_BuildInfoLines Include="        public const string FullLabel = &quot;$(Version) ($(Configuration), $(_GitShortHash))&quot;%3B" />
      <_BuildInfoLines Include="    }" />
      <_BuildInfoLines Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(_BuildInfoPath)" Lines="@(_BuildInfoLines)" Overwrite="true" Encoding="UTF-8" />
  </Target>

  <!--
    Explicit <Compile Include> for the generated file. The SDK's default
    **\*.cs glob would normally pick it up, but MSBuild's incremental build
    caches the glob result — a file that appears after the initial glob
    evaluation isn't seen by CoreCompile. Listing it explicitly forces a
    re-evaluation whenever the target runs. The matching Remove first
    prevents CS2002 "file specified multiple times" from the default glob
    also picking it up.
  -->
  <ItemGroup>
    <Compile Remove="$(MSBuildProjectDirectory)\Generated\BuildInfo.g.cs" />
    <Compile Include="$(MSBuildProjectDirectory)\Generated\BuildInfo.g.cs" />
  </ItemGroup>
</Project>

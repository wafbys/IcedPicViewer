<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
    <RootNamespace>IcedPicViewer</RootNamespace>
    <!-- <Version> is solution-wide: see the repository-root Directory.Build.props. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <!-- Only x64 architecture is supported for this project -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <!-- Embed AppIcon.ico as the .exe Win32 icon resource so Windows shows
         this app's icon in the taskbar and Alt+Tab. Without this, the
         .exe ships with a generic icon and the taskbar shows the default
         app silhouette. -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      AllowUnsafeBlocks: FFmpeg.AutoGen requires `unsafe` blocks for native
      pointer interop. Only FFmpegProbeService.cs (gated by IPV_FFMPEG_PROBE
      env var) uses this — production code paths do not.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- 完全删除多语言支持：不包含任何 satellite resources（af-ZA 等所有 xx-XX 文件夹）。
         本应用无自定义本地化资源（无 .resw），框架语言包对发布体积无益，全部剥离。 -->
    <SatelliteResourceLanguages></SatelliteResourceLanguages>

    <!-- Code Quality Analyzers -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- IDE style rules stay as suggestions in .editorconfig; do not promote to warnings in build. -->
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- CsWinRT: false positives in this project. Our HashSet<string>, ServiceCollection, etc.
         are never marshaled across the WinRT ABI; these are internal-only types. -->
    <NoWarn>$(NoWarn);CsWinRT1028;CsWinRT1030</NoWarn>
    <!-- SYSLIB1054 suggests LibraryImport (source-generated P/Invoke) over DllImport.
         We use DllImport for the native WndProc subclass hooks (SetWindowSubclass,
         DefSubclassProc) and for the legacy MessageBoxW fallback. Both are internal-only
         and never cross a marshalling boundary, so source-gen AOT benefits don't apply. -->
    <NoWarn>$(NoWarn);SYSLIB1054</NoWarn>
    <!-- CA2020 warns that (int)IntPtr cast doesn't throw on overflow in unchecked context.
         MainWindow's WH_KEYBOARD hook explicitly uses this cast to avoid an
         OverflowException from IntPtr.ToInt32() (which DOES throw on .NET 6+ when
         the IntPtr value is out of int range — observed in practice on Win11 25H2,
         where the OS hands us wParam/lParam with garbage high bits).
         The unchecked truncation is exactly what we want here. -->
    <NoWarn>$(NoWarn);CA2020</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <!--
      固定版本号 — SDK/runtime 必须对应:
      Microsoft.WindowsAppSDK 2.7.x ↔ 目标机 Windows App Runtime 2.7
      (unpackaged 由 bootstrapper 解析 framework package；Runtime 版本更低会启动失败)
    -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.7.0" />

    <!-- Archive via Core (SharpCompress); no direct package needed here. -->

    <!--
      FFmpeg.AutoGen: managed bindings only. Native DLLs are NOT in git —
      run tools/Fetch-FFmpegNatives.ps1 -Rid win-x64, which fills
      src/native/ffmpeg/win-x64. The CopyFFmpegDllsToOutDir target below is
      what places them in the output root.
    -->
    <PackageReference Include="FFmpeg.AutoGen" Version="9.0.1.1" />

    <!--
      LibVLC: playback fallback when Media Foundation cannot decode
      (VP8/WebM, ProRes, …). Soft-rendered via VlcImageSurface (no HWND VideoView).
    -->
    <PackageReference Include="LibVLCSharp" Version="3.10.2" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />

    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="11.0.100">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IcedPicViewer.Core\IcedPicViewer.Core.csproj" />
  </ItemGroup>

  <!--
    Build metadata read by BuildInfo.cs at runtime. BuildDateTime is the
    build start time (local); WindowsAppSdkVersion is the resolved
    PackageReference version, so the About page can never disagree with
    the actual dependency. GenerateAssemblyInfo emits these as
    [assembly: AssemblyMetadata].
  -->
  <ItemGroup>
    <AssemblyMetadata Include="BuildDateTime"
                      Value="$([System.DateTime]::Now.ToString('yyyy-MM-dd HH:mm'))" />
    <AssemblyMetadata Include="WindowsAppSdkVersion"
                      Value="@(PackageReference->WithMetadataValue('Identity', 'Microsoft.WindowsAppSDK')->'%(Version)')" />
  </ItemGroup>

  <!--
    Declared FFmpeg sonames: the native API set the FFmpeg.AutoGen PackageReference
    above binds to. Single source of truth — consumed by two places:
      * tools/Fetch-FFmpegNatives.ps1 parses this property for its own guard
      * CopyFFmpegDllsToOutDir compares it against the DLLs on disk (IPV002)

    Bump this property together with FFmpeg.AutoGen, then re-run
    ./tools/Fetch-FFmpegNatives.ps1 -Rid win-x64. A stale major version (e.g.
    FFmpeg 8.x avcodec-62 sitting next to 9.x bindings) does not fail the build
    on its own and does not crash: FFmpegBootstrap catches the load failure and
    disables video thumbnails at runtime, silently.
  -->
  <PropertyGroup>
    <FFmpegExpectedSonames>avutil-61;avcodec-63;avformat-63;avfilter-12;swscale-10;swresample-7</FFmpegExpectedSonames>
    <FFmpegNativeSourceDir>$(MSBuildProjectDirectory)\..\native\ffmpeg\win-x64</FFmpegNativeSourceDir>
  </PropertyGroup>

  <!--
    FFmpeg natives must be declared as <Content> so they land in the build
    output root next to the exe. FFmpegBootstrap calls LoadLibrary("avcodec-63")
    without a directory, and Windows does not search subdirectories.

    Link is explicit so the destination is the same flat layout the build
    output and the deployed folder use. Relying on the default
    runtimes\{rid}\native\ convention would also work (FFmpegBootstrap probes
    it) but would make debug and deployed layouts differ for no gain.

    Unconditional on purpose: a missing directory simply expands to zero
    files. Completeness is not its concern — a stale or partial set can never
    bind, so this copy cannot mask the mismatch. IPV002 in
    CopyFFmpegDllsToOutDir is what reports it; the metadata-based completeness
    check cannot live here because MSBuild rejects metadata references in
    item-definition conditions during evaluation.
  -->
  <ItemGroup>
    <Content Include="$(FFmpegNativeSourceDir)\*.dll"
             Link="%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    FFmpeg LGPL 2.1 license text. The default .NET SDK content globs do not
    pick up the License/ folder under this project, so it is listed explicitly.
    The About page opens <exe>\License\ffmpeg-LGPL.txt with the shell's default
    .txt handler, so the folder must be copied next to the exe.
  -->
  <ItemGroup>
    <Content Include="License\**\*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    CopyFFmpegDllsToOutDir: the <Content> item above already copies the DLLs
    for `dotnet build`/`dotnet run`; this target repeats the copy into
    $(OutDir) and, more importantly, validates the set against the declared
    sonames. Runs AfterBuild (debug + release).
  -->
  <Target Name="CopyFFmpegDllsToOutDir" AfterTargets="Build" Condition="'$(_DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <!-- Reported in the IPV002 message; keeps it pinned to the actual reference. -->
      <_FFmpegAutoGenVersion>@(PackageReference-&gt;WithMetadataValue('Identity', 'FFmpeg.AutoGen')-&gt;'%(Version)')</_FFmpegAutoGenVersion>
    </PropertyGroup>
    <ItemGroup>
      <_FFmpegDlls Include="$(FFmpegNativeSourceDir)\*.dll" />
      <!--
        Expected file names are derived by item TRANSFORM, not by a metadata value
        like <DllName>%(Filename).dll</DllName>: inside a target, built-in metadata
        in a metadata value silently evaluates to empty (that produced ".dll is
        missing" for every name). The transform yields real item specs, which is
        also what the batched Warning below batches over.
      -->
      <_FFmpegExpectedSoname Include="$(FFmpegExpectedSonames)" />
      <_FFmpegExpectedDll Include="@(_FFmpegExpectedSoname->'%(Identity).dll')" />
    </ItemGroup>
    <PropertyGroup>
      <!-- Empty-list-safe emptiness test that keeps an item reference out of the
           conditions below (a bare @(_FFmpegDlls) there would batch the task over
           that list as well). -->
      <_FFmpegDllCount>@(_FFmpegDlls->Count())</_FFmpegDllCount>
    </PropertyGroup>
    <!--
      IPV001: nothing at all on disk. IPV002: something is there but a declared
      (FFmpeg.AutoGen-bound) soname has no DLL — the stale-set case that otherwise
      only shows up as "video thumbnails silently gone" at runtime. IPV002 is
      batched over the expected names, so it fires once per missing name. Both
      messages carry the one-command fix.
    -->
    <Warning Code="IPV001"
             Text="FFmpeg native DLLs not found under src/native/ffmpeg/win-x64 (need: $(FFmpegExpectedSonames)). Video thumbs/probe will fail. Run: ./tools/Fetch-FFmpegNatives.ps1 -Rid win-x64"
             Condition="'$(_FFmpegDllCount)' == '0'" />
    <Warning Code="IPV002"
             Text="FFmpeg natives under src/native/ffmpeg/win-x64 do not match the declared sonames: %(_FFmpegExpectedDll.Identity) is missing (declared set: $(FFmpegExpectedSonames)). FFmpeg.AutoGen $(_FFmpegAutoGenVersion) cannot bind to the set while it is absent — video thumbs/metadata fail at runtime with no error. Run: ./tools/Fetch-FFmpegNatives.ps1 -Rid win-x64"
             Condition="'$(_FFmpegDllCount)' != '0' and !Exists('$(FFmpegNativeSourceDir)\%(_FFmpegExpectedDll.Identity)')" />
    <Copy SourceFiles="@(_FFmpegDlls)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="@(_FFmpegDlls) != ''" />
    <Message Text="CopyFFmpegDllsToOutDir: copied @(_FFmpegDlls) -&gt; $(OutDir)" Importance="high" Condition="@(_FFmpegDlls) != ''" />
  </Target>

  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!--
    WinUI 3 app, unpackaged (WindowsPackageType=None). The Windows App SDK
    bootstrapper resolves Microsoft.WindowsAppRuntime 2.7 from the
    framework package installed on the machine at launch; there is no MSIX
    package identity and no Package.appxmanifest.

    Build / Run flow:
      - `dotnet build -c Debug -p:Platform=x64` produces the layout at
        bin\$(Platform)\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\
      - `dotnet run` launches that exe directly (no package registration).
      - Release deployment copies the same layout to %USERPROFILE%\App\IcedPicViewer
        and creates a Start Menu shortcut; see tools/run-release.ps1.
  -->
  <PropertyGroup>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>
</Project>

<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="IcedPicViewer.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>

            <!--
                中文字体。默认全局字体走 XamlAutoFontFamily，它按应用语言
                解析字体 —— 清单此前只声明 en，中文字形因此走了泛化回退
                （宋体观感）。两道保险：
                1) 清单声明 zh-CN 为默认语言（Package.appxmanifest）——
                   XamlAutoFontFamily 随语言解析到简体中文 UI 字体；
                   type ramp 样式里硬编码的 XamlAutoFontFamily 也由此覆盖。
                2) 控件字体（ContentControlThemeFontFamily）与缺省文本
                   （隐式 TextBlock 样式）显式钉死：Segoe UI Variable Text
                   优先、Microsoft YaHei UI 兜底 —— 西文/数字保持 Segoe 观感，
                   中文字形落到微软雅黑 UI，且不依赖机器的显示语言设置。
                仅 Windows 11（目标 MinVersion 26100）运行，Segoe UI Variable
                必然存在，故回退链不需要再列旧字体。
            -->
            <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable Text, Microsoft YaHei UI</FontFamily>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI" />
            </Style>

            <!--
                应用级「字号阶」样式。与框架 ramp 同名同尺寸，只把 FontFamily
                显式钉死 —— 框架 ramp 内部硬编码 XamlAutoFontFamily，在
                SemiBold 请求下中文会出现「首字加粗、其余常规」的逐字不一致
                （2026-10 截图实证：同一 20px 字符串里 还=粗、其余=常规；
                显式字体链下渲染统一）。页面引用这些 App* 版本即可。
                注意：微软雅黑 UI 只有 Light/Regular/Bold、没有 Semibold，
                所以 SemiBold 请求会统一落到 Regular（层次靠字号区分）；
                若要标题更重，给对应样式或元素加 FontWeight="Bold" 即可。
            -->
            <Style x:Key="AppCaptionTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI" />
            </Style>
            <Style x:Key="AppBodyTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI" />
            </Style>
            <Style x:Key="AppBodyStrongTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI" />
            </Style>
            <Style x:Key="AppSubtitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI" />
            </Style>
            <Style x:Key="AppTitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- WinExe on Windows (no console); Exe elsewhere so Linux/macOS start cleanly. -->
    <OutputType Condition="$([MSBuild]::IsOSPlatform('Windows'))">WinExe</OutputType>
    <OutputType Condition="!$([MSBuild]::IsOSPlatform('Windows'))">Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Version>0.15.0</Version>
    <RootNamespace>IcedPicViewer.Avalonia</RootNamespace>
    <!-- Allow multi-RID restore of platform natives when publishing. -->
    <RuntimeIdentifiers>win-x64;win-arm64;osx-x64;osx-arm64;linux-x64;linux-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
    <!-- FFmpeg LGPL text next to the exe (About dialog path). -->
    <Content Include="License\**\*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="LibVLCSharp" Version="3.9.3" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />

    <!--
      LibVLC natives (NuGet ships Windows + macOS only; Linux uses distro packages).
      Reference both so restore/publish from any host can include the right RID assets.
    -->
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />
    <PackageReference Include="VideoLAN.LibVLC.Mac" Version="3.1.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IcedPicViewer.Core\IcedPicViewer.Core.csproj" />
  </ItemGroup>

  <!--
    FFmpeg shared libraries for video thumbnails (FFmpeg.AutoGen).
    Priority:
      1) src/native/ffmpeg/{rid}/  (from tools/Fetch-FFmpegNatives.*)
      2) WinUI win-x64 drop-in (existing BtbN LGPL shared build)
    Layout after copy: $(OutputDir)/runtimes/{rid}/native/*
  -->
  <ItemGroup>
    <None Include="..\native\ffmpeg\win-x64\*"
          Condition="Exists('..\native\ffmpeg\win-x64')"
          Link="runtimes\win-x64\native\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
    <None Include="..\native\ffmpeg\win-arm64\*"
          Condition="Exists('..\native\ffmpeg\win-arm64')"
          Link="runtimes\win-arm64\native\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
    <None Include="..\native\ffmpeg\linux-x64\*"
          Condition="Exists('..\native\ffmpeg\linux-x64')"
          Link="runtimes\linux-x64\native\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
    <None Include="..\native\ffmpeg\linux-arm64\*"
          Condition="Exists('..\native\ffmpeg\linux-arm64')"
          Link="runtimes\linux-arm64\native\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
    <None Include="..\native\ffmpeg\osx-x64\*"
          Condition="Exists('..\native\ffmpeg\osx-x64')"
          Link="runtimes\osx-x64\native\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
    <None Include="..\native\ffmpeg\osx-arm64\*"
          Condition="Exists('..\native\ffmpeg\osx-arm64')"
          Link="runtimes\osx-arm64\native\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

  <!-- Fallback: existing WinUI BtbN win-x64 FFmpeg DLLs when src/native/ffmpeg/win-x64 is empty. -->
  <ItemGroup Condition="!Exists('..\native\ffmpeg\win-x64\avutil-60.dll') and Exists('..\IcedPicViewer.WinUI\runtimes\win-x64\native\avutil-60.dll')">
    <None Include="..\IcedPicViewer.WinUI\runtimes\win-x64\native\*.dll"
          Link="runtimes\win-x64\native\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

  <!--
    Embed git short hash at build time (same idea as WinUI).
    File lands under Generated/ (gitignored); Compile Include is explicit so
    incremental builds always see it.
  -->
  <Target Name="GenerateBuildInfo" BeforeTargets="BeforeBuild" Condition="'$(_DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_GeneratedDir>$(MSBuildProjectDirectory)\Generated\</_GeneratedDir>
      <_BuildInfoPath>$(_GeneratedDir)BuildInfo.g.cs</_BuildInfoPath>
    </PropertyGroup>
    <MakeDir Directories="$(_GeneratedDir)" />
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" WorkingDirectory="$(MSBuildProjectDirectory)\..\..">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitShortHash" />
    </Exec>
    <PropertyGroup>
      <_GitShortHash>$(_GitShortHash.Trim())</_GitShortHash>
      <_GitShortHash Condition="'$(_GitShortHash)' == ''">unknown</_GitShortHash>
    </PropertyGroup>
    <ItemGroup>
      <_BuildInfoLines Include="// Auto-generated by build. Do not edit." />
      <_BuildInfoLines Include="namespace IcedPicViewer.Avalonia" />
      <_BuildInfoLines Include="{" />
      <_BuildInfoLines Include="    internal static class BuildInfo" />
      <_BuildInfoLines Include="    {" />
      <_BuildInfoLines Include="        public const string CommitShort = &quot;$(_GitShortHash)&quot;%3B" />
      <_BuildInfoLines Include="    }" />
      <_BuildInfoLines Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(_BuildInfoPath)" Lines="@(_BuildInfoLines)" Overwrite="true" Encoding="UTF-8" />
  </Target>

  <ItemGroup>
    <Compile Remove="$(MSBuildProjectDirectory)\Generated\BuildInfo.g.cs" />
    <Compile Include="$(MSBuildProjectDirectory)\Generated\BuildInfo.g.cs" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
    <RootNamespace>IcedPicViewer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <!-- Only x64 architecture is supported for this project -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Code Quality Analyzers -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- IDE style rules stay as suggestions in .editorconfig; do not promote to warnings in build. -->
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- CsWinRT: false positives in this project. Our HashSet<string>, ServiceCollection, etc.
         are never marshaled across the WinRT ABI; these are internal-only types. -->
    <NoWarn>$(NoWarn);CsWinRT1028;CsWinRT1030</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.0.1" />

    <!-- Static Analysis -->
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="*" />
  </ItemGroup>

  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!--
    Publish defaults so that a plain `dotnet publish -c Release -p:Platform=x64`
    (no extra -p: parameters) produces a self-contained, redistributable
    folder at bin\$(Platform)\$(Configuration)\$(TargetFramework)\win-x64\publish\
    that does NOT require the Windows App Runtime or .NET runtime to be
    installed on the target machine. Output is ~220 MB and bundles both
    the .NET runtime and the WindowsAppSDK native runtime.

    The same defaults also apply to `dotnet build`.
  -->
  <PropertyGroup>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained Condition="'$(WindowsAppSDKSelfContained)' == ''">true</WindowsAppSDKSelfContained>
    <!-- Force the WindowsAppSDK bootstrap auto-initializer to be generated.
         The SDK skips it by default when WindowsAppSDKSelfContained=true. -->
    <WindowsAppSdkBootstrapInitialize Condition="'$(WindowsAppSdkBootstrapInitialize)' == ''">true</WindowsAppSdkBootstrapInitialize>
    <PublishSingleFile>False</PublishSingleFile>
    <PublishDir>bin\$(Platform)\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish\</PublishDir>
  </PropertyGroup>

  <!--
    Copy WindowsAppRuntime.Bootstrap.dll to the build output root.

    With <RuntimeIdentifier>win-x64</RuntimeIdentifier> set, the native
    bootstrapper lands under runtimes\win-x64\native\ which is not
    searched by the WindowsAppSDK's P/Invoke loader (it only looks in
    the application directory and PATH). Setting
    WindowsAppSDKSelfContained=true alone does not flatten the layout
    for non-publish builds, so we copy explicitly.

  -->
  <Target Name="CopyWindowsAppRuntimeBootstrapToOutput"
          AfterTargets="Build"
          Condition="Exists('$(OutDir)runtimes\win-x64\native\Microsoft.WindowsAppRuntime.Bootstrap.dll')">
    <ItemGroup>
      <_WinAppSdkNative Include="$(OutDir)runtimes\win-x64\native\Microsoft.WindowsAppRuntime.Bootstrap.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_WinAppSdkNative)"
          DestinationFiles="@(_WinAppSdkNative->'$(OutDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!--
    Workaround: WindowsAppSDK 2.0's WinUI targets only add XAML/.xbf/.pri/Assets/Views
    to GetCopyToOutputDirectoryItems (build), not GetCopyToPublishDirectoryItems (publish).
    Without this, `dotnet publish` produces an exe that crashes on launch (0xC000027B)
    because it cannot find App.xbf / MainWindow.xbf / IcedPicViewer.pri / Assets / Views.
    This target copies those files from the build output to the publish directory.
  -->
  <Target Name="SyncWinUIBuildOutputToPublish"
          AfterTargets="Publish"
          Condition="'$(WindowsPackageType)' == 'None' and Exists('$(OutDir)') and '$(PublishDir)' != ''">
    <ItemGroup>
      <_WinUIPublishFiles Include="$(OutDir)**\*.xbf" />
      <_WinUIPublishFiles Include="$(OutDir)**\*.pri" />
      <_WinUIPublishFiles Include="$(OutDir)Assets\**\*"
                          Condition="Exists('$(OutDir)Assets')" />
      <_WinUIPublishFiles Include="$(OutDir)Views\**\*"
                          Condition="Exists('$(OutDir)Views')" />
      <_WinUIPublishFiles Include="$(OutDir)Microsoft.UI.Xaml\**\*"
                          Condition="Exists('$(OutDir)Microsoft.UI.Xaml')" />
    </ItemGroup>
    <Copy SourceFiles="@(_WinUIPublishFiles)"
          DestinationFiles="@(_WinUIPublishFiles->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
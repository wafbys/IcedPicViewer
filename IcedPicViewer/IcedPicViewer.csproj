<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
    <RootNamespace>IcedPicViewer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <!-- Only x64 architecture is supported for this project -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Embed AppIcon.ico as the .exe Win32 icon resource so Windows shows
         this app's icon in the taskbar and Alt+Tab. Without this, the
         .exe ships with a generic icon and the taskbar shows the default
         app silhouette. Assets\AppIcon.ico is already listed as Content
         above for MSIX manifest reference; this line additionally
         embeds it in the PE resource. -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 完全删除多语言支持：不包含任何 satellite resources（af-ZA 等所有 xx-XX 文件夹）。
         本应用无自定义本地化资源（无 .resw），框架语言包对发布体积无益，全部剥离。 -->
    <SatelliteResourceLanguages></SatelliteResourceLanguages>

    <!-- Code Quality Analyzers -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- IDE style rules stay as suggestions in .editorconfig; do not promote to warnings in build. -->
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- CsWinRT: false positives in this project. Our HashSet<string>, ServiceCollection, etc.
         are never marshaled across the WinRT ABI; these are internal-only types. -->
    <NoWarn>$(NoWarn);CsWinRT1028;CsWinRT1030</NoWarn>
    <!-- SYSLIB1054 suggests LibraryImport (source-generated P/Invoke) over DllImport.
         We use DllImport for the native WndProc subclass hooks (SetWindowSubclass,
         DefSubclassProc) and for the legacy MessageBoxW fallback. Both are internal-only
         and never cross a marshalling boundary, so source-gen AOT benefits don't apply. -->
    <NoWarn>$(NoWarn);SYSLIB1054</NoWarn>
    <!-- CA2020 warns that (int)IntPtr cast doesn't throw on overflow in unchecked context.
         MainWindow's WH_KEYBOARD hook explicitly uses this cast to avoid an
         OverflowException from IntPtr.ToInt32() (which DOES throw on .NET 6+ when
         the IntPtr value is out of int range — observed in practice on Win11 25H2
         + MSIX packaged, where the OS hands us wParam/lParam with garbage high bits).
         The unchecked truncation is exactly what we want here. -->
    <NoWarn>$(NoWarn);CA2020</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <!--
      固定版本号,严格遵循微软官方"SDK/runtime 版本必须严格对应"建议:
      - Microsoft.WindowsAppSDK 2.2.0 ↔ 目标机必须装 Windows App Runtime 2.2 standalone
      - 跨版本会启动报版本不匹配错误 (0x80004005 / "Microsoft.WindowsAppRuntime not found")
      - 微软文档示例永远用固定版本号,不用 floating
    -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
    <!--
      Microsoft.Windows.SDK.BuildTools.WinApp (WinApp SDK BuildTools):
      Adds first-class support for `dotnet run` on packaged WinUI apps.
      It hooks the .NET CLI Run target to register a debug identity via
      the winapp CLI and launch the app with package identity (AUMID).
      Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> to opt out.
    -->
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.3.2" />

    <!--
      Archive support: ZIP + RAR + 7Z (and tar/gz) read-only access for scanning
      picture files inside archives. Pure managed, no native dependencies, so the
      framework-dependent publish profile is unaffected. Per SharpCompress docs
      we use ArchiveFactory.Open(ArchiveType) overloads or let the factory sniff.
    -->
    <PackageReference Include="SharpCompress" Version="0.49.1" />

    <!-- Static Analysis -->
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="*" />
  </ItemGroup>

  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!--
    IcedPicViewer is a MSIX-packaged WinUI 3 app (WindowsPackageType is unset
    → defaults to MSIX). The Package.appxmanifest declares the framework
    dependency on Microsoft.WindowsAppRuntime 2.2, which Windows resolves
    automatically from the framework package — no standalone installer or
    Bootstrapper registration needed on the target machine.

    Build / Run / Publish flow:
      - `dotnet build -c Debug -p:Platform=x64` produces the AppX layout at
        bin\$(Platform)\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\AppX\
      - `dotnet run` (via Microsoft.Windows.SDK.BuildTools.WinApp, added above)
        registers a debug package identity (AUMID) and launches the app.
      - `dotnet publish -c Release -p:Platform=x64` produces a sideloadable
        .msix under bin\...\AppPackages\IcedPicViewer_0.12.0.0_x64.msix (and
        its dependency .msix files in the same folder).
  -->
  <PropertyGroup>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishDir>bin\$(Platform)\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish\</PublishDir>
  </PropertyGroup>

  <!--
    Unpackaged-only workaround (no-op for the current packaged build).
    WindowsAppSDK's WinUI targets only add XAML/.xbf/.pri/Assets/Views
    to GetCopyToOutputDirectoryItems (build), not GetCopyToPublishDirectoryItems
    (publish). Without this, an unpackaged `dotnet publish` produces an exe
    that crashes on launch (0xC000027B) because it cannot find App.xbf /
    MainWindow.xbf / Assets / Views. Verified still needed on WinAppSDK 2.2.0
    (2026-06-15) — Microsoft has not fixed this in 2.2.0; this target is
    required for any future unpackaged publish.

    IcedPicViewer is currently MSIX-packaged (WindowsPackageType unset),
    so this target is a no-op. Kept for the day someone needs an unpackaged
    build (e.g. for a portable .zip distribution).
  -->
  <Target Name="SyncWinUIBuildOutputToPublish" AfterTargets="Publish" Condition="'$(WindowsPackageType)' == 'None' and Exists('$(OutDir)') and '$(PublishDir)' != ''">
    <ItemGroup>
      <!--
        The recursive `**\*.xbf` / `**\*.pri` globs are required to catch
        view XAMLs that live under `Views\` (so %(RecursiveDir) is
        `\Views\` and the Copy destination ends up as
        $(PublishDir)\Views\...). $(PublishDir) in this project is
        $(OutDir)\publish\, so the globs WOULD also include files in
        that `publish\` subdir after the first run — and the Copy
        destination would re-write them at $(PublishDir)\publish\...
        (self-amplifying nesting bug, observed 2026-06-14).

        Fix: explicitly Exclude the publish\ subdir from the globs.
        Subdirs (Assets/, Views/, Microsoft.UI.Xaml/) are still listed
        below for clarity and to give them their own skip-if-missing
        guards, even though the recursive globs already cover them.
      -->
      <_WinUIPublishFiles Include="$(OutDir)**\*.xbf" Exclude="$(OutDir)publish\**" />
      <_WinUIPublishFiles Include="$(OutDir)**\*.pri" Exclude="$(OutDir)publish\**" />
      <_WinUIPublishFiles Include="$(OutDir)Assets\**\*" Condition="Exists('$(OutDir)Assets')" />
      <_WinUIPublishFiles Include="$(OutDir)Views\**\*" Condition="Exists('$(OutDir)Views')" />
      <_WinUIPublishFiles Include="$(OutDir)Microsoft.UI.Xaml\**\*" Condition="Exists('$(OutDir)Microsoft.UI.Xaml')" />
    </ItemGroup>
    <Copy SourceFiles="@(_WinUIPublishFiles)" DestinationFiles="@(_WinUIPublishFiles->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <!--
    彻底删除 bin/obj/publish 输出中的所有多语言支持 satellite 文件夹 (af-ZA, en-us, zh-CN 等所有文化目录)。
    本应用未使用任何多语言支持（无 .resw 本地化资源），这些文件夹仅来自框架，删除后输出目录更干净、体积更小。
    使用 PowerShell 识别所有匹配文化名称模式的子目录并删除。

    AfterTargets="Build;Publish" 同时覆盖 build 和 publish 两阶段,避免 build 产物
    (bin\Release\...) 残留 76 个 culture 目录、只有 publish 产物干净的'半清理'状态。

    Build 时只清 $(OutDir);publish 时还要清 $(PublishDir) —— 这两个目录都包含 .NET
    自带的 culture satellite 资源,只清一个会留 ~86 个 culture 目录在 publish 目录里。
  -->
  <Target Name="RemoveUnwantedCultures" AfterTargets="Build;Publish">
    <PropertyGroup>
      <_CultureDirsToClean>$(OutDir)</_CultureDirsToClean>
      <_CultureDirsToClean Condition="'$(PublishDir)' != '' AND '$(PublishDir)' != '$(OutDir)'">$(OutDir);$(PublishDir)</_CultureDirsToClean>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -Command &quot;@('$(OutDir)','$(PublishDir)') | Where-Object { $_ -ne '' -and (Test-Path $_) } | ForEach-Object { Get-ChildItem $_ -Directory -ErrorAction SilentlyContinue | Where-Object { $_.Name -match '^[a-zA-Z]{2,3}(-[A-Za-z]{2,4})?(-[A-Za-z]{2,})?$' } | Remove-Item -Recurse -Force -ErrorAction SilentlyContinue }&quot;" />
    <Message Text="已删除 $(OutDir) 和 $(PublishDir) 中的多语言支持文件夹 (af-ZA 等)" Importance="high" />
  </Target>

  <!--
    Embed the current git short commit hash into the assembly so the window
    title can display it at runtime. The hash is captured at build time (not
    at run time) so the displayed version always matches the running binary,
    and so the app doesn't need a .git directory on the user's machine.

    The generated file is written into the project's Generated/ folder so the
    SDK's default <Compile Include="**/*.cs" /> picks it up automatically —
    no need to manually wire it into the Compile item group. .gitignore
    excludes Generated/ so it never gets tracked.

    The const is used by MainWindow to set AppTitleBar.Title /
    AppWindow.Title at startup.

    Falls back to "unknown" when git is unavailable or the repo has no
    commits (e.g. fresh build server clone). _DesignTimeBuild skip avoids
    running git during IDE design-time XAML reloads.
  -->
  <Target Name="GenerateBuildInfo" BeforeTargets="BeforeBuild" Condition="'$(_DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_GeneratedDir>$(MSBuildProjectDirectory)\Generated\</_GeneratedDir>
      <_BuildInfoPath>$(_GeneratedDir)BuildInfo.g.cs</_BuildInfoPath>
    </PropertyGroup>
    <MakeDir Directories="$(_GeneratedDir)" />
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitShortHash" />
    </Exec>
    <PropertyGroup>
      <_GitShortHash>$(_GitShortHash.Trim())</_GitShortHash>
      <_GitShortHash Condition="'$(_GitShortHash)' == ''">unknown</_GitShortHash>
    </PropertyGroup>
    <ItemGroup>
      <_BuildInfoLines Include="// Auto-generated by build. Do not edit." />
      <_BuildInfoLines Include="namespace IcedPicViewer" />
      <_BuildInfoLines Include="{"/>
      <_BuildInfoLines Include="    internal static class BuildInfo" />
      <_BuildInfoLines Include="    {"/>
      <!--
        %3B escapes the trailing semicolon — MSBuild parses attribute values
        with `;` as list separators, so a literal `;` here would be silently
        dropped and the file would be syntactically broken.
      -->
      <_BuildInfoLines Include="        public const string CommitShort = &quot;$(_GitShortHash)&quot;%3B" />
      <_BuildInfoLines Include="    }"/>
      <_BuildInfoLines Include="}"/>
    </ItemGroup>
    <WriteLinesToFile File="$(_BuildInfoPath)" Lines="@(_BuildInfoLines)" Overwrite="true" Encoding="UTF-8" />
  </Target>

  <!--
    Explicit <Compile Include> for the generated file. The SDK's default
    **\*.cs glob would normally pick it up, but MSBuild's incremental build
    caches the glob result — a file that appears after the initial glob
    evaluation isn't seen by CoreCompile. Listing it explicitly forces a
    re-evaluation whenever the target runs. The matching Remove first
    prevents CS2002 "file specified multiple times" from the default glob
    also picking it up.
  -->
  <ItemGroup>
    <Compile Remove="$(MSBuildProjectDirectory)\Generated\BuildInfo.g.cs" />
    <Compile Include="$(MSBuildProjectDirectory)\Generated\BuildInfo.g.cs" />
  </ItemGroup>
</Project>

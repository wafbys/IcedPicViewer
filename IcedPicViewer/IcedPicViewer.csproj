<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
    <RootNamespace>IcedPicViewer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <!-- Only x64 architecture is supported for this project -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 完全删除多语言支持：不包含任何 satellite resources（af-ZA 等所有 xx-XX 文件夹）。
         本应用无自定义本地化资源（无 .resw），框架语言包对发布体积无益，全部剥离。 -->
    <SatelliteResourceLanguages></SatelliteResourceLanguages>

    <!-- Code Quality Analyzers -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- IDE style rules stay as suggestions in .editorconfig; do not promote to warnings in build. -->
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- CsWinRT: false positives in this project. Our HashSet<string>, ServiceCollection, etc.
         are never marshaled across the WinRT ABI; these are internal-only types. -->
    <NoWarn>$(NoWarn);CsWinRT1028;CsWinRT1030</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Floating versions: 跟随作者意图"总是最新"。每个包的浮动宽度按 breaking
      change 风险选:
      - Microsoft.WindowsAppSDK: "2.*"    — 锁 major 2.x (跨 major API 大改)
      - Microsoft.Extensions.Hosting: "[10.0.0,11.0.0)" — 锁 .NET 10 一代
      - Microsoft.Windows.SDK.BuildTools: "10.0.26200.*" — 锁同 OS SDK 代 (TFM=26200)
      - CommunityToolkit.Mvvm: "8.*"   — 锁 major (8.x stable)
      - SharpCompress / .NetAnalyzers: "*" — 历史无 breaking 风险

      Restore 时 nuget 会拉每个浮动的最新 stable 版本。CI / 其他开发者 build
      可能拉到不同的小版本 — 这是 floating 的代价,需要 CI 锁 transitive 依赖
      或用 lock file (`packages.lock.json`) 复现。
    -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="[10.0.0,11.0.0)" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.*" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.*" />

    <!--
      Archive support: ZIP + RAR + 7Z (and tar/gz) read-only access for scanning
      picture files inside archives. Pure managed, no native dependencies, so the
      framework-dependent publish profile is unaffected. Per SharpCompress docs
      we use ArchiveFactory.Open(ArchiveType) overloads or let the factory sniff.

      Pinned to 0.x: SharpCompress 1.0.0 (released 2026) is a major rewrite —
      ReaderFactory.OpenReader renamed to Open, signature changed to require
      ReaderOptions, IEntry/ArchiveEntry API restructured. Floating to * would
      silently break ArchiveHelper.cs. Upgrade to 1.x is a separate refactor
      (rewrite ArchiveHelper.cs against new API), tracked separately.
    -->
    <PackageReference Include="SharpCompress" Version="[0.49.0,1.0.0)" />

    <!-- Static Analysis -->
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="*" />
  </ItemGroup>

  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!--
    Publish defaults so that a plain `dotnet publish -c Release -p:Platform=x64`
    (no extra -p: parameters) produces a framework-dependent folder at
    bin\$(Platform)\$(Configuration)\$(TargetFramework)\win-x64\publish\
    that requires the .NET 10 runtime AND Windows App Runtime 2.2
    (or compatible) on the target machine.

    We use **framework-dependent** mode (not self-contained) on purpose:
    WindowsAppSDK self-contained bundles native DLLs (CoreMessagingXP.dll,
    dwmcorei.dll, dcomp.dll, ...) at a build NEWER than the user's OS, and
    those DLLs fail-fast on load with STATUS_FAIL_FAST_EXCEPTION (0xC0000602)
    because the DLLs are newer than the OS — observed in WinAppSDK 2.1.3
    (native DLLs at build 10.0.27200.1019 vs Win 11 25H2 GA build 26200).
    In framework-dependent mode the loader uses the OS's own versions from
    System32 / WinSxS, so the version mismatch is bypassed.

    Output is ~30 MB (no .NET runtime bundled). Target machine prerequisites:
      1. .NET 10 runtime
      2. Windows App Runtime 2.2 (installed via standalone installer, latest
         2.2.x build; the aka.ms URL always redirects to the current latest):
         https://aka.ms/windowsappsdk/2.0/latest/windowsappruntimeinstall-x64.exe
         SDK and runtime versions MUST match — SDK 2.2 with runtime 2.1.x
         fails at startup with a "0x80004005" or "Microsoft.WindowsAppRuntime
         not found" error.

    The same defaults also apply to `dotnet build`.
  -->
  <PropertyGroup>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <!-- Force the WindowsAppSDK bootstrap auto-initializer to be generated.
         The SDK skips it by default when WindowsAppSDKSelfContained=true. -->
    <WindowsAppSdkBootstrapInitialize Condition="'$(WindowsAppSdkBootstrapInitialize)' == ''">true</WindowsAppSdkBootstrapInitialize>
    <!-- Standard multi-file publish: produces a folder of .dll / .exe / .xbf / .pri
         rather than a single self-extracting IcedPicViewer.exe. Easier to debug,
         faster startup, no IncludeNativeLibrariesForSelfExtract side effects. -->
    <PublishSingleFile>false</PublishSingleFile>
    <PublishDir>bin\$(Platform)\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish\</PublishDir>
  </PropertyGroup>

  <!--
    Workaround: WindowsAppSDK's WinUI targets only add XAML/.xbf/.pri/Assets/Views
    to GetCopyToOutputDirectoryItems (build), not GetCopyToPublishDirectoryItems (publish).
    Without this, `dotnet publish` produces an exe that crashes on launch (0xC000027B)
    because it cannot find App.xbf / MainWindow.xbf / Assets / Views.

    Re-verified still needed on WindowsAppSDK 2.2.0 (2026-06-15): without this
    target the publish output is missing 15 files (App.xbf, MainWindow.xbf,
    GalleryView.xbf, ImageViewerView.xbf, Views\*.xbf, IcedPicViewer.pri,
    AppIcon.ico, all Square*/SplashScreen/StoreLogo/Wide*/LockScreen PNGs).
    Microsoft has not fixed this in 2.2.0; this target is required.
  -->
  <Target Name="SyncWinUIBuildOutputToPublish" AfterTargets="Publish" Condition="'$(WindowsPackageType)' == 'None' and Exists('$(OutDir)') and '$(PublishDir)' != ''">
    <ItemGroup>
      <!--
        The recursive `**\*.xbf` / `**\*.pri` globs are required to catch
        view XAMLs that live under `Views\` (so %(RecursiveDir) is
        `\Views\` and the Copy destination ends up as
        $(PublishDir)\Views\...). $(PublishDir) in this project is
        $(OutDir)\publish\, so the globs WOULD also include files in
        that `publish\` subdir after the first run — and the Copy
        destination would re-write them at $(PublishDir)\publish\...
        (self-amplifying nesting bug, observed 2026-06-14).

        Fix: explicitly Exclude the publish\ subdir from the globs.
        Subdirs (Assets/, Views/, Microsoft.UI.Xaml/) are still listed
        below for clarity and to give them their own skip-if-missing
        guards, even though the recursive globs already cover them.
      -->
      <_WinUIPublishFiles Include="$(OutDir)**\*.xbf" Exclude="$(OutDir)publish\**" />
      <_WinUIPublishFiles Include="$(OutDir)**\*.pri" Exclude="$(OutDir)publish\**" />
      <_WinUIPublishFiles Include="$(OutDir)Assets\**\*" Condition="Exists('$(OutDir)Assets')" />
      <_WinUIPublishFiles Include="$(OutDir)Views\**\*" Condition="Exists('$(OutDir)Views')" />
      <_WinUIPublishFiles Include="$(OutDir)Microsoft.UI.Xaml\**\*" Condition="Exists('$(OutDir)Microsoft.UI.Xaml')" />
    </ItemGroup>
    <Copy SourceFiles="@(_WinUIPublishFiles)" DestinationFiles="@(_WinUIPublishFiles->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <!--
    彻底删除 bin/obj/publish 输出中的所有多语言支持 satellite 文件夹 (af-ZA, en-us, zh-CN 等所有文化目录)。
    本应用未使用任何多语言支持（无 .resw 本地化资源），这些文件夹仅来自框架，删除后输出目录更干净、体积更小。
    使用 PowerShell 识别所有匹配文化名称模式的子目录并删除。

    AfterTargets="Build;Publish" 同时覆盖 build 和 publish 两阶段,避免 build 产物
    (bin\Release\...) 残留 76 个 culture 目录、只有 publish 产物干净的'半清理'状态。

    Build 时只清 $(OutDir);publish 时还要清 $(PublishDir) —— 这两个目录都包含 .NET
    自带的 culture satellite 资源,只清一个会留 ~86 个 culture 目录在 publish 目录里。
  -->
  <Target Name="RemoveUnwantedCultures" AfterTargets="Build;Publish">
    <PropertyGroup>
      <_CultureDirsToClean>$(OutDir)</_CultureDirsToClean>
      <_CultureDirsToClean Condition="'$(PublishDir)' != '' AND '$(PublishDir)' != '$(OutDir)'">$(OutDir);$(PublishDir)</_CultureDirsToClean>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -Command &quot;@('$(OutDir)','$(PublishDir)') | Where-Object { $_ -ne '' -and (Test-Path $_) } | ForEach-Object { Get-ChildItem $_ -Directory -ErrorAction SilentlyContinue | Where-Object { $_.Name -match '^[a-zA-Z]{2,3}(-[A-Za-z]{2,4})?(-[A-Za-z]{2,})?$' } | Remove-Item -Recurse -Force -ErrorAction SilentlyContinue }&quot;" />
    <Message Text="已删除 $(OutDir) 和 $(PublishDir) 中的多语言支持文件夹 (af-ZA 等)" Importance="high" />
  </Target>
</Project>

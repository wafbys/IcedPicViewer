<Page
    x:Class="IcedPicViewer.Views.ImageViewerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:IcedPicViewer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Dark"
    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">

    <Grid x:Name="MainContentGrid" IsTabStop="True">
        <Grid.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem Text="打开文件位置" Click="OpenFileLocation_Click"/>
                <MenuFlyoutItem Text="删除" Command="{x:Bind ViewModel.DeleteCommand}"/>
            </MenuFlyout>
        </Grid.ContextFlyout>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0"
                    DefaultLabelPosition="Collapsed"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
            <CommandBar.Content>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="{x:Bind ViewModel.CurrentImage.Name, Mode=OneWay}"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               Margin="0,0,8,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Margin="0,0,8,0" FontSize="12">
                        <Run Text="{x:Bind ViewModel.ActualWidth, Mode=OneWay}"/>
                        <Run Text="×"/>
                        <Run Text="{x:Bind ViewModel.ActualHeight, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Margin="0,0,8,0" FontSize="12">
                        <Run Text="{x:Bind ViewModel.CurrentImage.FileSizeText, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="{x:Bind ViewModel.ImagePath, Mode=OneWay}"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                </StackPanel>
            </CommandBar.Content>
            <AppBarButton Icon="Cancel"
                          Label="Close"
                          Command="{x:Bind ViewModel.CloseCommand}"
                          ToolTipService.ToolTip="Close"/>
            <AppBarSeparator/>
            <AppBarButton Icon="Previous"
                          Label="上一张"
                          Command="{x:Bind ViewModel.NavigatePreviousCommand}"
                          ToolTipService.ToolTip="上一张"/>
            <AppBarElementContainer>
                <TextBlock VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           Margin="4,0">
                    <Run Text="{x:Bind ViewModel.DisplayIndex, Mode=OneWay}"/>
                    <Run Text="/"/>
                    <Run Text="{x:Bind ViewModel.TotalCount, Mode=OneWay}"/>
                </TextBlock>
            </AppBarElementContainer>
            <AppBarButton Icon="Next"
                          Label="下一张"
                          Command="{x:Bind ViewModel.NavigateNextCommand}"
                          ToolTipService.ToolTip="下一张"/>
            <AppBarSeparator/>
            <!--
                Fit/1:1 toggle now works for both images and videos.
                For images: toggles between Viewbox (Fit) and ScrollViewer
                with the minimap (1:1). For videos: toggles between
                MediaPlayerElement.Stretch=Uniform (Fit) and Stretch=None
                inside a ScrollViewer (1:1, native resolution). Visibility
                stays Visible for both kinds — the user always gets the
                same affordance.
            -->
            <AppBarButton x:Name="FitModeBtn"
                          Icon="Zoom"
                          Label="Fit"
                          Click="FitModeBtn_Click"
                          ToolTipService.ToolTip="Fit / 1:1 切换"/>
            <AppBarButton Icon="Refresh"
                          Label="Load More"
                          Command="{x:Bind ViewModel.LoadMoreImagesCommand}"
                          Visibility="{x:Bind ViewModel.LoadMoreImagesVisibility, Mode=OneWay}"
                          ToolTipService.ToolTip="Load More (扫描更多图片)"/>
            <!--
                Slideshow toggle. Click to start / stop the auto-advance
                timer. Glyph + label + tooltip all switch on
                IsSlideshowActive so the user can tell at a glance
                whether the slideshow is running. While running, the
                timer fires every SlideshowInterval and calls
                NavigateNextCommand — Next is also bound to the
                arrow key, so the manual and auto paths share the
                same CanExecute / state.
            -->
            <AppBarButton Label="{x:Bind ViewModel.SlideshowLabel, Mode=OneWay}"
                          Command="{x:Bind ViewModel.SlideshowCommand}"
                          ToolTipService.ToolTip="{x:Bind ViewModel.SlideshowTooltip, Mode=OneWay}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="{x:Bind ViewModel.SlideshowGlyph, Mode=OneWay}"/>
                </AppBarButton.Icon>
            </AppBarButton>
            <!--
                Loop and Shuffle toggles. They modify the slideshow's
                behaviour rather than the slideshow's start/stop state,
                so they sit next to the Slideshow button (not nested
                inside a flyout) and can be flipped while the slideshow
                is running — the next tick picks up the new mode. The
                glyphs are constant; the tooltip + label flip to
                communicate the active state. WinUI 3's AppBarButton
                doesn't have a built-in "toggled" visual style for
                icons (the secondary Glyph stays the same), so a
                tooltip-driven approach is the most reliable indicator.
            -->
            <AppBarButton Label="{x:Bind ViewModel.SlideshowLoopLabel, Mode=OneWay}"
                          Click="SlideshowLoopBtn_Click"
                          ToolTipService.ToolTip="{x:Bind ViewModel.SlideshowLoopTooltip, Mode=OneWay}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="{x:Bind ViewModel.SlideshowLoopGlyph, Mode=OneWay}"/>
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="{x:Bind ViewModel.SlideshowShuffleLabel, Mode=OneWay}"
                          Click="SlideshowShuffleBtn_Click"
                          ToolTipService.ToolTip="{x:Bind ViewModel.SlideshowShuffleTooltip, Mode=OneWay}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="{x:Bind ViewModel.SlideshowShuffleGlyph, Mode=OneWay}"/>
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator/>
            <!--
                Fullscreen toggle. Glyph swaps between FullScreen (⛶)
                and BackToWindow (⤢) based on IsFullscreen, which is
                itself a live read of App.MainWindow.IsFullscreen so
                it stays correct after F11 toggles the presenter from
                outside the view. F11 keyboard shortcut fires the same
                ToggleFullscreen method via the WH_KEYBOARD hook in
                MainWindow.HandleViewerKey.
            -->
            <AppBarButton Label="{x:Bind IsFullscreenLabel, Mode=OneWay}"
                          Click="FullscreenBtn_Click"
                          ToolTipService.ToolTip="{x:Bind IsFullscreenTooltip, Mode=OneWay}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="{x:Bind IsFullscreenGlyph, Mode=OneWay}"/>
                </AppBarButton.Icon>
            </AppBarButton>
            <CommandBar.SecondaryCommands>
                <AppBarButton Icon="OpenFile"
                              Label="打开文件位置"
                              Click="OpenFileLocation_Click"
                              ToolTipService.ToolTip="在文件资源管理器中显示该文件"/>
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <!--
            Two content surfaces share the same Grid.Row="1" so they occupy
            the same area; visibility on their parent Grids (ImageHost /
            PlayerHost) decides which one is on screen. The split mirrors
            the user spec "默认静态首帧 + ▶,点才创建 MediaPlayerElement":
            the image surface (Viewbox + ScrollViewer + minimap) handles
            the static case, the player surface handles the playing case,
            and they're never both visible at once.
        -->
        <Grid x:Name="ImageHost"
              Grid.Row="1"
              Visibility="{x:Bind ViewModel.ImageHostVisibility, Mode=OneWay}">
            <Viewbox x:Name="FitContainer" Stretch="Uniform">
                <Image Source="{x:Bind ViewModel.DisplayImage, Mode=OneWay}"
                       Stretch="Uniform"
                       AutomationProperties.Name="{x:Bind ViewModel.CurrentImage.Name, Mode=OneWay}"/>
            </Viewbox>

            <ScrollViewer x:Name="ActualSizeContainer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          ViewChanged="ActualSizeContainer_ViewChanged"
                          SizeChanged="ActualSizeContainer_SizeChanged"
                          Visibility="Collapsed">
                <Image x:Name="ActualSizeImage" Source="{x:Bind ViewModel.DisplayImage, Mode=OneWay}"
                       Stretch="None"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Loaded="ActualSizeImage_Loaded"
                       ImageOpened="ActualSizeImage_ImageOpened"/>
            </ScrollViewer>

            <Grid x:Name="MinimapOverlay"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Margin="0,0,16,16" Visibility="Collapsed">
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4" Padding="4">
                    <Grid>
                        <Image x:Name="MinimapImage" Stretch="Uniform" />
                        <!--
                            MinimapViewport is the pointer target (not MinimapImage).
                            Reasoning: Image.Stretch=Uniform leaves transparent padding
                            around the picture, and a moving mouse over that padding
                            never reached Image.PointerMoved. With Background="Transparent"
                            the Canvas hit-tests its full 150x120 area, and routed
                            events bubble up here from the viewport Rectangle too.
                        -->
                        <Canvas x:Name="MinimapViewport"
                                Background="Transparent"
                                Width="150" Height="120"
                                PointerPressed="MinimapImage_PointerPressed"
                                PointerMoved="MinimapImage_PointerMoved"
                                PointerReleased="MinimapImage_PointerReleased"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid x:Name="PlayerHost"
              Grid.Row="1"
              Visibility="{x:Bind ViewModel.PlayerHostVisibility, Mode=OneWay}">
            <!--
                Static first frame behind the play overlay. Same source as
                the gallery's Thumbnail, so the user sees the same picture
                they tapped on — no surprise reload. Visibility stays
                Visible even while the player is rendering on top; the
                MediaPlayerElement's surface is opaque so the underlying
                Image is hidden in practice.
            -->
            <Image Source="{x:Bind ViewModel.DisplayImage, Mode=OneWay}"
                   Stretch="Uniform"/>
            <!--
                Centered play button. Visible only when IsVideo is true AND
                IsVideoPlaying is false — once playback starts, the
                MediaPlayerElement takes over and the built-in transport
                controls (play/pause/scrubber) own the chrome. Background
                is a fixed semi-opaque black for the same reason as the
                gallery card ▶: it has to read clearly on any first
                frame, regardless of the video's dominant colour.
            -->
            <Button x:Name="PlayOverlay"
                    Visibility="{x:Bind ViewModel.IsPlayOverlayVisibility, Mode=OneWay}"
                    Click="PlayOverlay_Click"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#CC000000"
                    BorderThickness="0"
                    Width="80" Height="80"
                    CornerRadius="40"
                    Padding="0"
                    ToolTipService.ToolTip="播放 (Space)">
                <FontIcon Glyph="&#xE768;" FontSize="36" Foreground="White"/>
            </Button>
            <!--
                Two containers for the MediaPlayerElement. The element
                itself is initially in PlayerFitContainer; when the
                user toggles to 1:1 mode the view's code-behind
                reparents it into PlayerScrollViewer (and back when
                they return to Fit). Reparenting is needed because:

                - A ScrollViewer always offers infinite layout space to
                  its child, which is the right behaviour for 1:1
                  mode (native resolution is larger than the viewport,
                  the ScrollViewer allows panning) but the wrong
                  behaviour for Fit mode (Uniform stretch needs a
                  finite viewport to know what to scale to — inside
                  a ScrollViewer the element ends up at the video's
                  natural size, not scaled to fit).
                - A Grid gives the element a finite layout slot, which
                  is right for Fit mode (Uniform stretches correctly)
                  but offers no scroll affordance for 1:1 mode.

                Two containers + reparenting gives each mode the host
                it needs without paying for a complex Grid+ScrollViewer
                stack or a custom canvas. Visibility on the containers
                is gated by IsVideo && IsFitMode (or !IsFitMode) &&
                IsVideoPlaying, so the element is only ever laid out
                when there's actually a player to render — preventing
                the v0.14.2 "no media" state that blocked pointer
                events on the PlayOverlay button.

                The ScrollViewer's scroll modes are fixed at Auto
                (not bound) because the ScrollViewer itself is only
                Visible in 1:1 mode — in Fit mode it's Collapsed and
                its scroll mode is irrelevant. Hardcoding here
                removes a binding round-trip without changing
                behaviour.
            -->
            <Grid x:Name="PlayerFitContainer"
                  Visibility="{x:Bind ViewModel.PlayerFitContainerVisibility, Mode=OneWay}">
                <MediaPlayerElement x:Name="Player"
                                    AreTransportControlsEnabled="{x:Bind ViewModel.PlayerUseBuiltInControls, Mode=OneWay}"
                                    Stretch="{x:Bind ViewModel.PlayerStretch, Mode=OneWay}"/>
            </Grid>
            <!--
                1:1 host: outer Grid with two rows. Row 0 is a
                ScrollViewer (which the Player is reparented into); row 1
                is a custom transport-controls strip pinned to the
                bottom of the container. The strip owns the
                play/pause / seek / time-display UI in 1:1 mode so
                the controls are always reachable, even when the
                ScrollViewer is showing only the top edge of the
                1920x1080 frame. AreTransportControlsEnabled is
                False in this mode (the MediaPlayerElement is the
                video source only, the chrome lives outside the
                element).
            -->
            <Grid x:Name="PlayerActualSizeContainer"
                  Visibility="{x:Bind ViewModel.PlayerActualSizeContainerVisibility, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer x:Name="PlayerScrollViewerInner"
                              Grid.Row="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Auto"
                              VerticalScrollMode="Auto"/>
                <Grid x:Name="PlayerControlsStrip"
                      Grid.Row="1"
                      Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                      Padding="8,4"
                      ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PlayPauseBtn"
                            Grid.Column="0"
                            Click="PlayPauseBtn_Click"
                            ToolTipService.ToolTip="Play / Pause (Space)">
                        <FontIcon x:Name="PlayPauseGlyph" Glyph="&#xE768;"/>
                    </Button>
                    <Slider x:Name="PositionSlider"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Minimum="0"
                            Maximum="100"
                            Value="0"
                            StepFrequency="1"
                            SmallChange="1"
                            LargeChange="10"
                            PointerEntered="PositionSlider_PointerEntered"
                            PointerExited="PositionSlider_PointerExited"
                            ValueChanged="PositionSlider_ValueChanged"/>
                    <TextBlock x:Name="TimeText"
                               Grid.Column="2"
                               Text="0:00 / 0:00"
                               VerticalAlignment="Center"
                               FontSize="12"
                               MinWidth="90"
                               TextAlignment="Right"/>
                </Grid>
            </Grid>
        </Grid>

        <ProgressRing Grid.Row="1"
                      IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Width="48"
                      Height="48"/>
    </Grid>
</Page>

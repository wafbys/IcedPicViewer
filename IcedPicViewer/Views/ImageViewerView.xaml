<Page
    x:Class="IcedPicViewer.Views.ImageViewerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:IcedPicViewer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#E0000000">

    <Grid x:Name="MainContentGrid" IsTabStop="True">
        <Grid.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem Text="打开文件位置" Click="OpenFileLocation_Click"/>
                <MenuFlyoutItem Text="删除" Command="{Binding DeleteCommand}"/>
            </MenuFlyout>
        </Grid.ContextFlyout>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#44000000">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                <Button Content="Close" Command="{Binding CloseCommand}" Padding="12,6"/>
                <TextBlock Text="{Binding CurrentImage.Name}" VerticalAlignment="Center" Foreground="White" Margin="16,0" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                <TextBlock VerticalAlignment="Center" Foreground="#AAA" Margin="8,0" FontSize="12">
                    <Run Text="{Binding ActualWidth}"/>
                    <Run Text="×"/>
                    <Run Text="{Binding ActualHeight}"/>
                </TextBlock>
                <TextBlock VerticalAlignment="Center" Foreground="#AAA" Margin="8,0" FontSize="12">
                    <Run Text="{Binding CurrentImage.FileSizeText}"/>
                </TextBlock>
                <TextBlock Text="{Binding ImagePath}" VerticalAlignment="Center" Foreground="#666" Margin="16,0" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="400"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                <Button Content="&lt;" Command="{Binding NavigatePreviousCommand}" Width="36" Height="36" FontSize="18" Margin="4,0"/>
                <TextBlock VerticalAlignment="Center" Foreground="White" Margin="8,0">
                    <Run Text="{Binding DisplayIndex}"/>
                    <Run Text="/"/>
                    <Run Text="{Binding TotalCount}"/>
                </TextBlock>
                <Button Content="&gt;" Command="{Binding NavigateNextCommand}" Width="36" Height="36" FontSize="18" Margin="4,0"/>

                <!-- 单图模式下的 Load More（支持到底自动加载更多） -->
                <Button Content="Load More"
                        Command="{Binding LoadMoreImagesCommand}"
                        Visibility="{Binding LoadMoreImagesVisibility}"
                        Margin="12,0,0,0"
                        Padding="8,4"/> 

                <Button x:Name="FitModeBtn" Content="Fit" Click="FitModeBtn_Click" MinWidth="50" Height="36" FontSize="12" Margin="16,0,0,0" Padding="8,0"/>
            </StackPanel>
        </Grid>

        <Viewbox x:Name="FitContainer" Grid.Row="1" Stretch="Uniform">
            <Image Source="{Binding DisplayImage}" Stretch="Uniform"/>
        </Viewbox>

        <ScrollViewer x:Name="ActualSizeContainer" Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      ViewChanged="ActualSizeContainer_ViewChanged"
                      SizeChanged="ActualSizeContainer_SizeChanged"
                      Visibility="Collapsed">
            <Image x:Name="ActualSizeImage" Source="{Binding DisplayImage}"
                   Stretch="None"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Loaded="ActualSizeImage_Loaded"
                   ImageOpened="ActualSizeImage_ImageOpened"/>
        </ScrollViewer>

        <Grid x:Name="MinimapOverlay" Grid.Row="1"
              HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Margin="0,0,16,16" Visibility="Collapsed">
            <Border Background="#88000000" CornerRadius="4" Padding="4">
                <Grid>
                    <Image x:Name="MinimapImage" Stretch="Uniform" />
                    <!--
                        MinimapViewport is the pointer target (not MinimapImage).
                        Reasoning: Image.Stretch=Uniform leaves transparent padding
                        around the picture, and a moving mouse over that padding
                        never reached Image.PointerMoved. With Background="Transparent"
                        the Canvas hit-tests its full 150x120 area, and routed
                        events bubble up here from the viewport Rectangle too.
                    -->
                    <Canvas x:Name="MinimapViewport"
                            Background="Transparent"
                            Width="150" Height="120"
                            PointerPressed="MinimapImage_PointerPressed"
                            PointerMoved="MinimapImage_PointerMoved"
                            PointerReleased="MinimapImage_PointerReleased"/>
                </Grid>
            </Border>
        </Grid>

        <ProgressRing Grid.Row="1"
                      IsActive="{Binding IsLoading}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Width="48"
                      Height="48"/>
    </Grid>
</Page>

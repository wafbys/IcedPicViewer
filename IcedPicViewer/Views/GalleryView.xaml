<Page
    x:Class="IcedPicViewer.Views.GalleryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:IcedPicViewer"
    xmlns:controls="using:IcedPicViewer.Controls"
    xmlns:models="using:IcedPicViewer.Models"
    xmlns:vm="using:IcedPicViewer.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:DataType="vm:GalleryViewModel"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                <Button Content="Open Folder"
                        Command="{x:Bind ViewModel.OpenFolderCommand}"
                        Padding="12,6"/>
            </StackPanel>
        </Grid>

        <ScrollViewer x:Name="MainScrollViewer"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <!-- Using the original working MasonryPanel to restore the exact waterfall visual the user requested.
                 Note: This is non-virtualizing. Virtualization work is tracked separately. -->
            <ItemsControl x:Name="MainItemsControl" ItemsSource="{x:Bind ViewModel.Images, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:MasonryPanel ItemWidth="220" ItemSpacing="8"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ImageItem">
                        <Border Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
                                CornerRadius="4"
                                Margin="0"
                                Padding="4"
                                DoubleTapped="ImageItem_DoubleTapped"
                                RightTapped="ImageItem_RightTapped"
                                PointerEntered="ImageItem_PointerEntered"
                                PointerExited="ImageItem_PointerExited">
                            <Border.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="打开文件位置" Click="OpenFileLocation_Click"/>
                                    <MenuFlyoutItem Text="删除" Click="DeleteMenuItem_Click"/>
                                </MenuFlyout>
                            </Border.ContextFlyout>
                            <Grid MinHeight="120">
                                <Image Source="{x:Bind Thumbnail, Mode=OneWay}"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                                <Border x:Name="NameOverlay"
                                        Background="#88000000"
                                        CornerRadius="2"
                                        Padding="6,4"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,0,8"
                                        Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                                   Foreground="White"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="200"/>
                                        <TextBlock Foreground="#CCC"
                                                   FontSize="10"
                                                   MaxWidth="200">
                                            <Run Text="{x:Bind OriginalSizeText, Mode=OneTime}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{x:Bind FileSizeText, Mode=OneTime}"/>
                                        </TextBlock>
                                        <TextBlock Text="{x:Bind DisplayLocation, Mode=OneWay}"
                                                   Foreground="#999"
                                                   FontSize="10"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="200"
                                                   ToolTipService.ToolTip="{x:Bind DisplayLocation, Mode=OneWay}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="2" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" VerticalAlignment="Center" FontSize="12"/>

                <!-- Incremental loading button to reduce initial lag while keeping masonry visual -->
                <Button Content="Load More"
                        Command="{x:Bind ViewModel.LoadMoreCommand}"
                        Visibility="{x:Bind ViewModel.LoadMoreVisibility, Mode=OneWay}"
                        Margin="12,0,0,0"
                        Padding="8,4"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>

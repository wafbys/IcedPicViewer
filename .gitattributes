# Dual Windows + Fedora / Grok Build: always LF in the repo AND working tree.
# (eol=lf prevents checkout as CRLF; pair with core.autocrlf=false and files.eol=\n)
* text=auto eol=lf

*.cs text eol=lf
*.xaml text eol=lf
*.axaml text eol=lf
*.csproj text eol=lf
*.slnx text eol=lf
*.md text eol=lf
*.json text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.xml text eol=lf
*.manifest text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.editorconfig text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Binary
*.png binary
*.jpg binary
*.ico binary
*.dll binary
*.so binary
*.dylib binary
*.user binary

# Normalize text files to LF in the repo (avoids whole-file EOL noise on review).
* text=auto eol=lf

*.cs text eol=lf
*.xaml text eol=lf
*.axaml text eol=lf
*.csproj text eol=lf
*.slnx text eol=lf
*.md text eol=lf
*.json text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf

# Binary
*.png binary
*.jpg binary
*.ico binary
*.dll binary
*.so binary
*.dylib binary
